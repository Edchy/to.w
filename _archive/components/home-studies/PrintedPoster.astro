---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import bestHero from "../../content/gallery/besthero.jpg";
import handsCutout from "../../assets/img/studies/besthero-hands-cutout-study-v1.png";
import cheetahStudy from "../../assets/img/studies/cobalt-cheetah-study-v1.png";
import birdStudy from "../../assets/img/studies/wading-bird-pencil-study-v1.png";
import ringStudy from "../../assets/img/studies/silver-ring-cutout-study-v1.png";
import { getProductSlug } from "../../config/site";
import CoursesSection from "./CoursesSection.astro";
import AboutSection from "./AboutSection.astro";
import InstagramSection from "./InstagramSection.astro";

type Props = { items: CollectionEntry<"jewelry">[] };
const { items } = Astro.props;
const featured = items.slice(0, 3);
const fmt = new Intl.NumberFormat("sv-SE").format;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<article class="poster" data-direction-panel="poster" hidden>
  <header class="poster__header">
    <a href={baseUrl}>towtow</a>
    <nav aria-label="Huvudnavigering">
      <a href={withBase("/smycken")}>Smycken</a>
      <a href={withBase("/kurser")}>Kurser</a>
      <a href={withBase("/om")}>Om</a>
    </nav>
  </header>

  <main>
    <section class="poster__hero">
      <Image class="poster__hero-hands" src={handsCutout} alt="Händer med flera handgjorda silverringar." loading="eager" />
      <p class="poster__kicker">Handgjort i Järna</p>
      <h1>Jag gör det<br />som jag går.</h1>
      <a class="poster__hero-link" href={withBase("/smycken")}>se ringarna ↘</a>
    </section>

    <section class="poster__statement" aria-label="Om arbetet">
      <p>Enkla former. Återvunnet silver. Spår av handen får vara kvar.</p>
      <Image src={cheetahStudy} alt="" aria-hidden="true" />
    </section>

    <section class="poster__work" aria-labelledby="poster-products-title">
      <div class="poster__work-header">
        <h2 id="poster-products-title">Smycken</h2>
        <div class="poster__density" role="group" aria-label="Avstånd mellan produktbilder">
          <button type="button" data-density-option="air" aria-pressed="true">Luft</button>
          <button type="button" data-density-option="tight" aria-pressed="false">Tätt</button>
        </div>
      </div>

      <div class="poster__products" data-product-grid data-density="air">
        {featured.map((entry, index) => (
          <a class:list={["poster__product", `poster__product--${index + 1}`]} href={withBase(`/smycken/${getProductSlug(entry.id)}`)}>
            <span class="poster__product-image">
              {index === 0 && (
                <Image class="poster__product-backdrop poster__product-backdrop--photo" src={bestHero} alt="" aria-hidden="true" loading="lazy" />
              )}
              {index === 1 && (
                <Image class="poster__product-backdrop poster__product-backdrop--drawing" src={cheetahStudy} alt="" aria-hidden="true" loading="lazy" />
              )}
              {index === 2 && (
                <Image class="poster__product-backdrop poster__product-backdrop--bird" src={birdStudy} alt="" aria-hidden="true" loading="lazy" />
              )}
              <Image class="poster__product-ring" src={ringStudy} alt={`Silverring som platshållare för ${entry.data.title}`} loading="lazy" />
            </span>
            <span class="poster__product-meta">
              <span>{entry.data.title}</span>
              <span>{fmt(entry.data.price)} kr</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <CoursesSection variant="02" />
    <AboutSection variant="02" />
    <InstagramSection variant="02" />
  </main>

  <footer class="poster__footer">
    <span>TO.W · Tove Wätte</span>
    <Image class="poster__footer-hands" src={handsCutout} alt="" aria-hidden="true" loading="lazy" />
    <a href="https://instagram.com/tovewatte">Instagram</a>
  </footer>
</article>

<script>
  const grid = document.querySelector<HTMLElement>("[data-product-grid]");
  const densityButtons = document.querySelectorAll<HTMLButtonElement>("[data-density-option]");

  densityButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const density = button.dataset.densityOption;
      if (!grid || !density) return;

      grid.dataset.density = density;
      densityButtons.forEach((option) => {
        option.setAttribute("aria-pressed", String(option === button));
      });
    });
  });
</script>

<style>
  .poster {
    min-height: 100vh;
    color: var(--study-ink);
    background: var(--study-paper-bright);
    font-family: var(--font-study-sans);
  }

  .poster a {
    color: inherit;
  }

  .poster__header {
    position: absolute;
    z-index: var(--z-raised);
    inset-inline: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding: var(--space-lg) calc(var(--layout-gutter) + var(--space-32)) var(--space-lg) var(--layout-gutter);
    color: var(--study-paper-bright);
    font-weight: var(--font-weight-semibold);
  }

  .poster__header > a {
    font-family: var(--font-study-isenheim);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
  }

  .poster__header nav {
    display: flex;
    gap: var(--space-lg);
  }

  .poster__hero {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    overflow: hidden;
    padding: var(--space-24) var(--layout-gutter) var(--space-12);
    color: var(--study-paper-bright);
    background-color: var(--study-wine);
    isolation: isolate;
  }

  .poster__hero > :global(img.poster__hero-hands) {
    position: absolute;
    z-index: -2;
    top: 4%;
    right: -2%;
    width: min(92vw, 90rem);
    height: 92%;
    object-fit: contain;
    object-position: right center;
  }

  .poster__hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: var(--study-paper-texture);
    opacity: 0.35;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .poster__kicker {
    width: fit-content;
    margin: 0 0 var(--space-lg);
    padding: var(--space-xs) var(--space-sm);
    color: var(--study-ink);
    background: var(--study-yellow);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-wide);
    text-transform: uppercase;
  }

  .poster h1 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-study-fashion);
    font-size: var(--study-type-poster-hero);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-leading-poster);
    letter-spacing: var(--font-tracking-poster);
    font-optical-sizing: auto;
  }

  .poster__hero-link {
    width: fit-content;
    margin-top: var(--space-10);
    padding: var(--space-sm) var(--space-md);
    color: var(--study-ink);
    background: var(--study-pink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    text-transform: uppercase;
  }

  .poster__statement {
    position: relative;
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: var(--space-32) var(--layout-gutter);
    background-color: var(--study-paper);
    background-image: var(--study-paper-texture);
  }

  .poster__statement p {
    position: relative;
    z-index: var(--z-raised);
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-study-fashion);
    font-size: var(--study-type-poster-statement);
    line-height: var(--font-leading-statement);
    text-align: center;
    font-optical-sizing: auto;
  }

  .poster__statement :global(img) {
    position: absolute;
    right: 5%;
    bottom: var(--space-10);
    width: min(42vw, 38rem);
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    transform: rotate(-6deg);
  }

  .poster__work {
    padding-block: var(--space-20) var(--space-24);
    background: var(--study-paper-bright);
  }

  .poster__work-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding: 0 var(--layout-gutter) var(--space-xl);
  }

  .poster__work-header h2 {
    margin: 0;
    font-family: var(--font-study-fashion);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-medium);
  }

  .poster__density {
    display: flex;
    gap: var(--space-sm);
  }

  .poster__density button {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--study-ink);
    border-radius: var(--radius-full);
    color: var(--study-ink);
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .poster__density button[aria-pressed="true"] {
    color: var(--study-paper-bright);
    background: var(--study-ink);
  }

  .poster__products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
  }

  .poster__products[data-density="air"] {
    gap: var(--space-lg);
    padding-inline: var(--layout-gutter);
  }

  .poster__products[data-density="tight"] {
    gap: 0;
  }

  .poster__product {
    display: grid;
    align-content: start;
    color: var(--study-ink);
    text-decoration: none;
  }

  .poster__product-image {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .poster__product--1 .poster__product-image {
    background: var(--study-wine);
  }

  .poster__product--2 .poster__product-image {
    background: var(--study-yellow);
  }

  .poster__product--3 .poster__product-image {
    background: var(--study-pink);
  }

  .poster__product-image :global(img.poster__product-backdrop) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .poster__product-image :global(img.poster__product-backdrop--photo) {
    object-fit: cover;
    filter: saturate(0.7) contrast(1.1) sepia(0.15);
    opacity: 0.72;
  }

  .poster__product-image :global(img.poster__product-backdrop--drawing) {
    inset: auto 3% 7%;
    width: 94%;
    height: auto;
    object-fit: contain;
    transform: rotate(-5deg);
  }

  .poster__product-image :global(img.poster__product-backdrop--bird) {
    inset: 8% auto auto 8%;
    width: 48%;
    height: auto;
    object-fit: contain;
    transform: rotate(-8deg);
    opacity: 0.72;
  }

  .poster__product-image :global(img.poster__product-ring) {
    position: absolute;
    z-index: var(--z-raised);
    top: 50%;
    left: 50%;
    display: block;
    width: 72%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    transform: translate(-50%, -50%);
    transition: transform var(--transition-slow);
  }

  .poster__product-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: baseline;
    padding-block: var(--space-md);
    font-size: var(--font-size-sm);
  }

  .poster__products[data-density="tight"] .poster__product-meta {
    padding-inline: var(--space-md);
  }

  .poster__product-meta span:first-child {
    font-family: var(--font-study-fashion);
    font-size: var(--font-size-lg);
  }

  .poster__product-meta span:last-child {
    white-space: nowrap;
  }

  .poster__footer {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--space-72);
    overflow: visible;
    padding: var(--space-10) var(--layout-gutter);
    color: var(--study-paper-bright);
    background: var(--study-ink);
    isolation: isolate;
  }

  .poster__footer > span,
  .poster__footer > a {
    position: relative;
    z-index: var(--z-raised);
  }

  .poster__footer :global(img.poster__footer-hands) {
    position: absolute;
    z-index: var(--z-base);
    top: 10%;
    left: 50%;
    width: min(72vw, 54rem);
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    transform: translate(-50%, -50%) rotate(180deg);
    opacity: 0.82;
  }

  @media (hover: hover) {
    .poster__product:hover .poster__product-image :global(img.poster__product-ring) {
      transform: translate(-50%, -50%) scale(1.035) rotate(-2deg);
    }
  }

  @media (max-width: 760px) {
    .poster__header {
      align-items: flex-start;
      padding-right: var(--space-16);
    }

    .poster__header nav {
      flex-direction: column;
      gap: var(--space-sm);
      padding-right: var(--space-12);
    }

    .poster h1 {
      font-size: var(--study-type-poster-hero-mobile);
    }

    .poster__hero > :global(img.poster__hero-hands) {
      top: 16%;
      right: -30%;
      width: 135vw;
      height: 76%;
    }

    .poster__statement {
      min-height: 70vh;
    }

    .poster__statement p {
      text-align: left;
    }

    .poster__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .poster__products[data-density="air"] {
      gap: var(--space-md);
    }

    .poster__product-meta {
      display: grid;
      gap: var(--space-xs);
    }

    .poster__product-meta span:first-child {
      font-size: var(--font-size-base);
    }

    .poster__footer :global(img.poster__footer-hands) {
      width: 150vw;
    }

  }
</style>
