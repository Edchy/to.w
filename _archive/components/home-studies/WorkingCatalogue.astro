---
import type { CollectionEntry } from "astro:content";
import RingProducts from "./RingProducts.astro";
import CoursesSection from "./CoursesSection.astro";
import AboutSection from "./AboutSection.astro";
import InstagramSection from "./InstagramSection.astro";

type Props = { items: CollectionEntry<"jewelry">[] };
const { items } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<article class="catalogue" data-direction-panel="catalogue" hidden>
  <header class="catalogue__header">
    <a class="catalogue__wordmark" href={baseUrl}>towtow</a>
    <p>Handgjorda smycken<br />Järna, Sverige</p>
    <nav aria-label="Huvudnavigering">
      <a href={withBase("/smycken")}>Smycken</a>
      <a href={withBase("/kurser")}>Kurser</a>
      <a href={withBase("/om")}>Om</a>
    </nav>
  </header>

  <main>
    <section class="catalogue__intro">
      <p class="catalogue__index">Index 01—06</p>
      <h1>Ringar som får<br />visa hur de blev till.</h1>
      <p class="catalogue__lede">Återvunnet silver, formade för hand av Tove Wätte. Varje exemplar får behålla små skillnader och spår av arbetet.</p>
    </section>

    <RingProducts items={items} variant="03" />

    <CoursesSection variant="03" />
    <AboutSection variant="03" />
    <InstagramSection variant="03" />
  </main>

  <footer class="catalogue__footer">
    <span>TO.W</span>
    <a href="mailto:tove.watte@gmail.com">Beställ och fråga via mejl</a>
    <span>© {new Date().getFullYear()}</span>
  </footer>
</article>

<style>
  .catalogue {
    min-height: 100vh;
    color: var(--study-ink);
    background: var(--study-paper-bright);
    font-family: var(--font-study-sans);
  }

  .catalogue a {
    color: inherit;
  }

  .catalogue__header,
  .catalogue__intro,
  .catalogue__footer {
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .catalogue__header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--grid-gutter);
    align-items: start;
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--study-ink);
  }

  .catalogue__wordmark {
    font-family: var(--font-study-isenheim);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
  }

  .catalogue__header p {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .catalogue__header nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-lg);
    padding-right: var(--space-32);
  }

  .catalogue__intro {
    display: grid;
    grid-template-columns: 0.35fr 1.3fr 0.6fr;
    gap: var(--grid-gutter);
    align-items: end;
    padding-block: var(--space-24) var(--space-32);
  }

  .catalogue__index,
  .catalogue__lede {
    margin: 0;
  }

  .catalogue__index {
    align-self: start;
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--font-tracking-wide);
  }

  .catalogue h1 {
    margin: 0;
    font-family: var(--font-study-serif);
    font-size: var(--study-type-catalogue-hero);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-leading-display);
    letter-spacing: var(--font-tracking-negative);
  }

  .catalogue__lede {
    max-width: 34ch;
    font-size: var(--font-size-base);
  }

  .catalogue__footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-10);
    border-top: 1px solid var(--study-ink);
  }

  .catalogue__footer span:last-child {
    justify-self: end;
  }

  @media (max-width: 800px) {
    .catalogue__header {
      grid-template-columns: 1fr 1fr;
    }

    .catalogue__header > p {
      display: none;
    }

    .catalogue__header nav {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-sm);
      padding-right: var(--space-12);
    }

    .catalogue__intro {
      grid-template-columns: 1fr;
      padding-block: var(--space-16) var(--space-20);
    }

    .catalogue h1 {
      font-size: var(--study-type-catalogue-hero-mobile);
    }

    .catalogue__footer {
      grid-template-columns: 1fr auto;
    }

    .catalogue__footer a {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
