---
import type { StudyVariant } from "./types";

type Props = { variant: Exclude<StudyVariant, "01" | "02" | "03"> };

const { variant } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<footer class:list={["sfoot", `sfoot--v${variant}`]}>
  <a class="sfoot__wordmark" href={baseUrl}>towtow</a>

  <nav aria-label="Sidfot">
    <a href={`${baseUrl}smycken/`}>smycken</a>
    <a href={`${baseUrl}kurser/`}>kurser</a>
    <a href={`${baseUrl}om/`}>om</a>
  </nav>

  <div class="sfoot__contact">
    <a href="mailto:tove.watte@gmail.com">tove.watte@gmail.com</a>
    <a href="https://instagram.com/tovewatte">@tovewatte</a>
  </div>

  <p class="sfoot__small">Tove Wätte · Järna · © {new Date().getFullYear()}</p>
</footer>

<style>
  .sfoot {
    --sec-bg: transparent;
    --sec-fg: inherit;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-lg) var(--space-3xl);
    align-items: start;
    padding: var(--space-16) max(var(--layout-gutter), calc((100% - var(--layout-site-width)) / 2)) var(--space-10);
    color: var(--sec-fg);
    background: var(--sec-bg);
    border-top: 1px solid currentColor;
  }

  .sfoot a {
    color: inherit;
    text-decoration: none;
  }

  .sfoot a:hover {
    text-decoration: underline;
  }

  .sfoot__wordmark {
    font-family: var(--font-study-isenheim);
    font-size: var(--font-size-3xl);
    letter-spacing: var(--font-tracking-negative);
  }

  .sfoot nav,
  .sfoot__contact {
    display: grid;
    gap: var(--space-xs);
  }

  .sfoot__small {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
    text-transform: uppercase;
  }

  .sfoot--v05 {
    font-family: var(--font-study-sans);
  }

  .sfoot--v06 {
    --sec-bg: var(--study-paper-bright);
  }

  .sfoot--v07 {
    --sec-bg: var(--study-ink);
    --sec-fg: var(--study-paper-bright);
  }

  .sfoot--v08 {
    --sec-bg: var(--study-cobalt);
    --sec-fg: var(--study-paper-bright);
  }

  @media (max-width: 700px) {
    .sfoot {
      grid-template-columns: 1fr 1fr;
    }

    .sfoot__wordmark {
      grid-column: 1 / -1;
    }
  }
</style>
