---
import "../styles/global.css";
import { CONTACT_EMAIL_HREF } from "../config/site";

type Props = {
  title?: string;
  description?: string;
  noPadding?: boolean;
  overlayHeader?: boolean;
  noindex?: boolean;
  bare?: boolean;
};

const {
  title,
  description = "Tove Wättes webbplats.",
  noindex = false,
  bare = false,
} = Astro.props;

const pageTitle = title ? `TO.W | ${title}` : "TO.W";
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => {
  const url = `${baseUrl}${path.replace(/^\//, "")}`;
  return /\.[a-z0-9]+$/i.test(url) || url.endsWith("/") ? url : `${url}/`;
};

const siteOrigin = Astro.site?.origin ?? "";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const currentPath = Astro.url.pathname.replace(
  new URL(baseUrl, "https://example.com").pathname.replace(/\/$/, ""),
  "",
) || "/";

const navLinks = [
  { href: "/smycken", label: "Smycken" },
  { href: "/kurser", label: "Kurser" },
  { href: "/om", label: "Om" },
];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={withBase("/t-fav.svg")} />
  </head>
  <body class:list={{ "prototype-body": bare }}>
    {!bare && <header class="reset-header">
      <a class="reset-wordmark" href={baseUrl}>TO.W</a>
      <nav aria-label="Huvudnavigering">
        <ul class="reset-nav" role="list">
          {navLinks.map(({ href, label }) => (
            <li>
              <a href={withBase(href)} aria-current={currentPath.startsWith(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>}

    <main>
      <slot />
    </main>

    {!bare && <footer class="reset-footer">
      <a href={CONTACT_EMAIL_HREF}>Kontakt</a>
    </footer>}
  </body>
</html>
