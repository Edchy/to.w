---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Link-preview image (a site path or absolute URL); defaults to the logo card. */
  image?: string;
  imageAlt?: string;
  /** Structured data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
};

const {
  title,
  description = "Tove Wättes webbplats.",
  noindex = false,
  image,
  imageAlt = "O· ur TO·W-ordmärket över två händer med handgjorda silverringar",
  jsonLd,
} = Astro.props;

// Page name first so tabs stay distinct; the homepage carries the tagline.
const pageTitle = title ? `${title} | TO·W` : "TO·W | Silversmycken";
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => {
  const url = `${baseUrl}${path.replace(/^\//, "")}`;
  return /\.[a-z0-9]+$/i.test(url) || url.endsWith("/") ? url : `${url}/`;
};

const siteOrigin = Astro.site?.origin ?? "";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
// Shared image for link previews (the logo on white, 1200×630); must be an absolute URL.
const ogImageUrl = new URL(image ?? withBase("/og.png"), siteOrigin).href;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="TO·W" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
