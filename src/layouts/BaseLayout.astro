---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { CONTACT_EMAIL, CONTACT_EMAIL_HREF } from "../config/site";
import Wordmark from "../components/Wordmark.astro";

type Props = {
  title?: string;
  description?: string;
  noPadding?: boolean;
};

const { title, description = "Handgjorda smycken i silver och stickmönster — av Tove Wätte, Järna.", noPadding = false } = Astro.props;
const pageTitle = title ? `to.w - ${title}` : "to.w";
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
const currentYear = new Date().getFullYear();

const siteOrigin = Astro.site?.origin ?? "";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = `${siteOrigin}${withBase("/og.png")}`;

const footerNavLinks = [
  { href: "/smycken", label: "smycken" },
  { href: "/stickning", label: "stickning" },
  { href: "/projekt", label: "projekt" },
  { href: "/gallery", label: "galleri" },
  { href: "/kurser", label: "kurser" },
  { href: "/om", label: "om" },
];
const headerNavLinks = footerNavLinks;

const basePath = new URL(baseUrl, "https://example.com").pathname.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(basePath, "") || "/";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="to.w" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="sv_SE" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
<Font cssVariable="--font-body" />
    <Font cssVariable="--font-chillax" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <div class="site-wrap site-header__inner">
        <Wordmark href={baseUrl} size="nav" />
        <nav aria-label="Huvudnavigering">
          <ul class="nav-list" role="list">
            {headerNavLinks.map(({ href, label }) => (
              <li>
                <a
                  href={withBase(href)}
                  class:list={["nav-link", { "nav-link--active": currentPath === href || (href !== "/" && currentPath.startsWith(href)) }]}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button class="hamburger" aria-label="Öppna meny" aria-expanded="false" aria-controls="mobile-nav">
          <span class="hamburger__bar"></span>
          <span class="hamburger__bar"></span>
        </button>
      </div>
    </header>

    <div class="mobile-nav" id="mobile-nav" role="dialog" aria-label="Meny" aria-modal="true">
      <ul class="mobile-nav__list" role="list">
        {headerNavLinks.map(({ href, label }) => (
          <li>
            <a
              href={withBase(href)}
              class:list={["mobile-nav__link", { "mobile-nav__link--active": currentPath === href || (href !== "/" && currentPath.startsWith(href)) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <main class:list={[{ "main--no-padding": noPadding }]}>
      <slot />
    </main>

    <footer class:list={["site-footer", { "site-footer--hidden": noPadding }]}>
      <div class="site-wrap site-footer__inner">
        <div class="footer-directory">
          <nav class="footer-group" aria-label="Sidfotsnavigering">
            <ul class="footer-links" role="list">
              {footerNavLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={withBase(href)}
                    class:list={["footer-link", { "footer-link--active": currentPath === href || (href !== "/" && currentPath.startsWith(href)) }]}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="footer-group">
            <ul class="footer-socials" role="list">
              <li>
                <a href="https://instagram.com/tovewatte" target="_blank" rel="noopener noreferrer">instagram</a>
              </li>
              <li>
                <a href={CONTACT_EMAIL_HREF}>email</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="footer-colophon">
          <p>&copy; {currentYear} tove wätte</p>
          <p>
            website by
            <a href="https://nope.digital" target="_blank" rel="noopener noreferrer">nope</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  function initHamburger() {
    const btn = document.querySelector('.hamburger');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;

    if (btn.dataset.hamburgerInit) return;
    btn.dataset.hamburgerInit = '1';

    const main = document.querySelector('main');
    const footer = document.querySelector('.site-footer');
    let lockedScrollY = 0;
    let isScrollLocked = false;

    function lockPageScroll() {
      if (isScrollLocked) return;
      lockedScrollY = window.scrollY;
      isScrollLocked = true;
      document.documentElement.classList.add('has-mobile-nav-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }

    function unlockPageScroll() {
      if (!isScrollLocked) return;
      isScrollLocked = false;
      document.documentElement.classList.remove('has-mobile-nav-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, lockedScrollY);
    }

    function openMenu() {
      nav.classList.add('is-open');
      lockPageScroll();
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Stäng meny');
      main?.setAttribute('inert', '');
      footer?.setAttribute('inert', '');
      const firstLink = nav.querySelector('a, button');
      firstLink?.focus();
    }

    function closeMenu() {
      nav.classList.remove('is-open');
      unlockPageScroll();
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Öppna meny');
      main?.removeAttribute('inert');
      footer?.removeAttribute('inert');
      btn.focus();
    }

    btn.addEventListener('click', () => {
      btn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });

    nav.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    document.addEventListener('astro:after-swap', () => {
      nav.classList.remove('is-open');
      unlockPageScroll();
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Öppna meny');
      main?.removeAttribute('inert');
      footer?.removeAttribute('inert');
    });
  }

  document.addEventListener('astro:page-load', initHamburger);
  initHamburger();
</script>

<script is:inline>
  // Tab title: soften presence when focus leaves
  (function () {
    const original = document.title;
    document.addEventListener('visibilitychange', () => {
      document.title = document.hidden ? '— to.w' : original;
    });
  })();

  // Console art: handmade message for curious visitors
  console.log(
    '%c\n  t  o  .  w\n\n%chandgjorda smycken & stickning\nJärna, Sverige\n\nhttps://to.w\n',
    'font-size:18px; letter-spacing:0.3em; color:#7a8c6a; font-family:monospace',
    'font-size:11px; color:#9a9082; font-family:monospace; letter-spacing:0.05em'
  );
</script>


<style>
  .site-wrap {
    width: 100%;
    max-width: var(--layout-site-width);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  /* ── Header ── */

  .site-header {
    position: relative;
    z-index: var(--z-modal);
    height: var(--nav-height);
    background-color: var(--color-bg-base);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-wide);
    text-transform: lowercase;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* Active state is carried by colour alone — no rule, no underline. */
  .nav-link--active {
    color: var(--color-accent);
  }

  .nav-link--active:hover {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .nav-list {
      display: none;
    }
  }

  main {
    padding-top: var(--space-8);
    flex: 1;
  }

  main.main--no-padding {
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1000px) {
    main.main--no-padding {
      padding-top: 0;
    }
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: var(--duration-slow);
    animation-timing-function: var(--ease-out-quart);
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-old(root)),
    :global(::view-transition-new(root)) {
      animation: none;
    }
  }

  /* ── Footer ── */
  /* Flat: same paper ground as the page, no slab, no border. */

  .site-footer--hidden {
    display: none;
  }

  .site-footer {
    margin-top: var(--space-32);
    padding-block: var(--space-12);
    background-color: var(--color-bg-base);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .footer-directory {
    display: flex;
    gap: var(--space-16);
  }

  .footer-links,
  .footer-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-links a,
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    letter-spacing: var(--font-tracking-wide);
    text-transform: lowercase;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-socials a:hover {
    color: var(--color-text-primary);
  }

  .footer-link--active {
    color: var(--color-accent);
  }

  .footer-link--active:hover {
    color: var(--color-accent);
  }

  .footer-colophon {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: right;
  }

  .footer-colophon p {
    margin: 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    letter-spacing: var(--font-tracking-wide);
    line-height: var(--font-leading-snug);
    text-transform: lowercase;
  }

  .footer-colophon a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-colophon a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 760px) {
    .site-footer {
      margin-top: var(--space-20);
      padding-block: var(--space-10);
    }

    .site-footer__inner {
      flex-direction: column;
      gap: var(--space-8);
    }

    .footer-directory {
      gap: var(--space-12);
    }

    .footer-colophon {
      text-align: left;
    }
  }

  /* ── Hamburger button ── */

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .hamburger__bar {
    display: block;
    width: 22px;
    height: 1px;
    background-color: var(--color-wordmark-nav);
    transform-origin: center;
    transition: transform var(--transition-normal);
  }

  .hamburger[aria-expanded="true"] .hamburger__bar:nth-child(1) {
    transform: translateY(2.5px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger__bar:nth-child(2) {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .hamburger {
      display: flex;
    }
  }

  /* ── Mobile nav panel ── */

  .mobile-nav {
    position: fixed;
    inset: 0;
    top: var(--nav-height);
    background-color: var(--color-bg-base);
    z-index: var(--z-overlay);
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow-y: auto;
    padding: var(--space-8) var(--layout-gutter);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-normal);
  }

  .mobile-nav.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html.has-mobile-nav-open),
  :global(html.has-mobile-nav-open body) {
    overflow: hidden;
  }

  .mobile-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .mobile-nav__link {
    display: block;
    padding-block: var(--space-3);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-negative);
    text-transform: lowercase;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .mobile-nav__link:hover {
    color: var(--color-text-primary);
  }

  .mobile-nav__link--active {
    color: var(--color-accent);
  }
</style>
