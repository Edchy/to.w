---
import VFrame from "../../../components/v/VFrame.astro";
import Home1 from "../../../components/v/Home1.astro";
import Home2 from "../../../components/v/Home2.astro";
import Home4 from "../../../components/v/Home4.astro";
import Home5 from "../../../components/v/Home5.astro";
import { getPieces, getVariant, variantPaths } from "../../../components/v/catalog";

export const getStaticPaths = variantPaths;
const { v } = Astro.params;
const pieces = await getPieces();
const { look, hero } = getVariant(v);
const Home = { "1": Home1, "2": Home2, "4": Home4, "5": Home5 }[look];
---

<VFrame v={v}>
  <Home v={v} pieces={pieces} hero={hero} />
</VFrame>
