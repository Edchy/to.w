---
import VFrame from "../../../../components/v/VFrame.astro";
import Shop from "../../../../components/v/Shop.astro";
import { getPieces, variantPaths } from "../../../../components/v/catalog";

export const getStaticPaths = variantPaths;
const { v } = Astro.params;
const pieces = await getPieces();
---

<VFrame v={v} title="Smycken" page="smycken">
  <Shop v={v} pieces={pieces} />
</VFrame>
