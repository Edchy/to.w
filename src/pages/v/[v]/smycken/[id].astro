---
import VFrame from "../../../../components/v/VFrame.astro";
import Product from "../../../../components/v/Product.astro";
import { VARIANTS, getPieces } from "../../../../components/v/catalog";

export async function getStaticPaths() {
  const pieces = await getPieces();
  return VARIANTS.flatMap(({ n }) =>
    pieces.map((piece) => ({ params: { v: n, id: piece.slug }, props: { piece, others: pieces.filter((p) => p !== piece) } })),
  );
}

const { v } = Astro.params;
const { piece, others } = Astro.props;
---

<VFrame v={v} title={piece.title} page={`smycken/${piece.slug}`}>
  <Product v={v} piece={piece} others={others} />
</VFrame>
