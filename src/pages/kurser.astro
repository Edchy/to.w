---
import BaseLayout from "../layouts/BaseLayout.astro";
import { openOccasions } from "../data/courses";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const successUrl = `${baseUrl}kurser/tack/`;
---

<BaseLayout title="Kurser">
  <section class="reset-shell">
    <h1>Kurser</h1>
    <p>Sidans innehåll är tömt inför omarbetning. Intresseanmälan finns kvar som fungerande grund.</p>

    <form
      class="reset-form"
      name="intresseanmalan"
      method="POST"
      action={successUrl}
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="intresseanmalan" />
      <input type="hidden" name="subject" value="Ny intresseanmälan — kurs" />

      <p class="reset-honeypot" aria-hidden="true">
        <label>
          Lämna det här fältet tomt
          <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <label>
        Namn
        <input type="text" name="namn" autocomplete="name" required />
      </label>

      <label>
        E-post
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label>
        Telefon (valfritt)
        <input type="tel" name="telefon" autocomplete="tel" />
      </label>

      <label>
        Kurs
        <select name="kurs" required>
          {openOccasions.map(({ course, date }) => (
            <option value={`${course.title} — ${date.date}`}>
              {date.date} — {course.title}
            </option>
          ))}
        </select>
      </label>

      <label>
        Meddelande eller fråga (valfritt)
        <textarea name="meddelande" rows="4"></textarea>
      </label>

      <button type="submit">Skicka intresseanmälan</button>
    </form>
  </section>
</BaseLayout>
