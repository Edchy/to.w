---
import { existsSync } from "node:fs";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/site/SiteFrame.astro";
import ProductCarousel from "../../components/home/ProductCarousel.astro";
import { CONTACT_EMAIL_HREF, RING_TRANSITION_CLASS, getProductSlug, ringTransitionName } from "../../config/site";
import "../../styles/pages.css";

export async function getStaticPaths() {
  const items = (await getCollection("jewelry")).sort((a, b) => b.data.date.localeCompare(a.data.date));
  return items.map((entry) => ({
    params: { id: getProductSlug(entry.id) },
    props: { entry, others: items.filter((item) => item.id !== entry.id) },
  }));
}

const { entry, others } = Astro.props;
const { title, kind, price, sizes, description, body, material, technique, design, images } = entry.data;

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const formattedPrice = new Intl.NumberFormat("sv-SE").format(price);

// A loose 3D model of the piece (scripts/make-rings.mjs), named by slug without diacritics.
const modelName = getProductSlug(entry.id).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
const hasModel = existsSync(`public/models/${modelName}.glb`);

// Facts with a real value (the data has some blanks and "tba"s).
const clean = (value?: string) => (value?.trim() && value.trim() !== "tba" ? value.trim() : undefined);
const facts = [
  { term: "Material", value: clean(material) },
  { term: "Teknik", value: clean(technique) },
  { term: "Form", value: clean(design) },
  { term: sizes.length === 1 ? "Storlek" : "Storlekar", value: sizes.join(", ") || undefined },
].filter((fact) => fact.value);

// Search and link previews: the title says what the piece is, the description is cut at a sentence
// so it fits a result snippet (~155 characters), and previews show the real photo.
const pageTitle = kind ? `${title} – ${kind} i återvunnet silver` : title;
const summary = (text: string, max = 155) => {
  const sentences = text.match(/[^.!?]+[.!?]*/g) ?? [text];
  let out = "";
  for (const sentence of sentences) {
    if ((out + sentence).trim().length > max) break;
    out += sentence;
  }
  return (out || text.slice(0, max)).trim();
};
const metaDescription = summary(clean(description) ?? `${title}, handgjort smycke i återvunnet silver av Tove Wätte.`);
const photo = images[0] ? await getImage({ src: images[0], width: 1200, format: "jpg" }) : undefined;
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: title,
  description: clean(description),
  image: photo ? new URL(photo.src, Astro.site).href : undefined,
  material: clean(material),
  brand: { "@type": "Brand", name: "To.W" },
  offers: {
    "@type": "Offer",
    url: productUrl,
    price,
    priceCurrency: "SEK",
    availability: "https://schema.org/MadeToOrder",
  },
};

// The order button opens a prefilled mail.
const sizeLine =
  sizes.length === 1 ? `Storlek / variant: ${sizes[0]}` : `Storlek / variant (välj: ${sizes.join(", ")}):`;
const orderBody = `Hej Tove,

Jag vill gärna beställa ${title} (${formattedPrice} kr).

${sizeLine}
Antal:
LEVERANS: [post / hämtas i ateljén / överlämning i Järna]
Adress, om post:
Telefon:
Övrigt:

Vänliga hälsningar,`;
const orderHref = `${CONTACT_EMAIL_HREF}?subject=${encodeURIComponent(`Beställning: ${title}`)}&body=${encodeURIComponent(orderBody)}`;
---

<BaseLayout bare title={pageTitle} description={metaDescription} image={photo?.src} imageAlt={`${title}, ${kind ?? "smycke"} i återvunnet silver`} jsonLd={jsonLd}>
  <SiteFrame>
    <div class="pg pd">
      <div class="pd__media" data-product-media>
        {images[0] && (
          <Image
            class="pd__photo"
            src={images[0]}
            alt={`${title}, ${kind ?? "smycke"} i återvunnet silver`}
            widths={[640, 960, 1440, 1920]}
            sizes="(max-width: 900px) 100vw, 58vw"
            loading="eager"
            fetchpriority="high"
          />
        )}

        {hasModel && (
          <div class="pd__model-view">
            <model-viewer
              class="pd__model"
              src={`${baseUrl}models/${modelName}.glb`}
              alt={`3D-test av ${title}, ${kind ?? "smycke"} i återvunnet silver. Dra för att vrida.`}
              camera-controls
              disable-zoom
              touch-action="pan-y"
              min-camera-orbit="auto 0deg 120%"
              max-camera-orbit="auto 180deg 120%"
              camera-orbit="30deg 70deg 120%"
              environment-image="neutral"
              auto-rotate
              auto-rotate-delay="0"
              rotation-per-second="20deg"
            ></model-viewer>
            <p class="pd__model-note"><strong>3D-test.</strong> Återger inte smyckets exakta form eller yta.</p>
          </div>
        )}
      </div>

      {hasModel && (
        <button class="pd__toggle" type="button" data-model-toggle aria-pressed="false">Vrid i 3D</button>
      )}

      <div class="pd__info">
        <a class="pd__back" href={`${baseUrl}smycken/`}>← alla smycken</a>

        <div class="pd__name">
          <h1 class="pg__heading pd__title" style={`view-transition-name: ${ringTransitionName(getProductSlug(entry.id))}; view-transition-class: ${RING_TRANSITION_CLASS}`}>{title}</h1>
          <p class="pd__price">{formattedPrice} kr</p>
        </div>

        {(clean(description) || clean(body)) && (
          <div class="pd__copy">
            {clean(description) && <p>{clean(description)}</p>}
            {clean(body) && <p>{clean(body)}</p>}
          </div>
        )}

        {facts.length > 0 && (
          <dl class="pg__ledger pd__facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.term}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="pd__order">
          <a class="pg__btn" href={orderHref}>Beställ via mejl →</a>
          <p class="pd__note">
            Smycket görs för hand efter din beställning. Jag återkommer med bekräftelse, betalningsinfo och
            ungefärlig leveranstid.
          </p>
        </div>
      </div>
    </div>

    <section class="pd__more" aria-labelledby="more-title">
      <h2 class="pg__heading pd__more-title" id="more-title">Fler smycken</h2>
      <ProductCarousel items={others} photos />
    </section>
  </SiteFrame>
</BaseLayout>

<script>
  import "@google/model-viewer";

  // "Vrid i 3D" swaps the photo for the model, in the same frame, and back.
  document.querySelectorAll<HTMLButtonElement>("[data-model-toggle]").forEach((toggle) => {
    const media = document.querySelector<HTMLElement>("[data-product-media]");
    toggle.addEventListener("click", () => {
      const on = toggle.getAttribute("aria-pressed") !== "true";
      toggle.setAttribute("aria-pressed", String(on));
      toggle.textContent = on ? "Visa foto" : "Vrid i 3D";
      media?.toggleAttribute("data-model", on);
    });
  });

  // No turning on its own for visitors who ask for less motion; dragging still works.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const model of document.querySelectorAll("model-viewer[auto-rotate]")) model.removeAttribute("auto-rotate");
  }
</script>

<style>
  /*
   * The photo leads, large, on the left; everything about the piece sits beside it in one column
   * that stays in view while the photo scrolls. Nothing is folded away.
   */
  .pd {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      "media info"
      "toggle info";
    grid-template-rows: auto 1fr;
    gap: var(--space-4) var(--grid-gutter);
    padding-bottom: 0;
  }

  .pd__media {
    grid-area: media;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .pd__media :global(img.pd__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The model takes the photo's frame; the photo keeps the frame's size while hidden. */
  .pd__model-view {
    position: absolute;
    inset: 0;
    display: none;
    grid-template-rows: minmax(0, 1fr) auto;
    padding: var(--space-4);
  }

  .pd__media[data-model] :global(img.pd__photo) {
    visibility: hidden;
  }

  .pd__media[data-model] .pd__model-view {
    display: grid;
  }

  .pd__model {
    --poster-color: transparent;

    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .pd__model:active {
    cursor: grabbing;
  }

  .pd__model-note {
    font-family: var(--font-text);
    font-size: var(--font-size-sm);
    font-size-adjust: var(--font-text-adjust);
    line-height: var(--font-leading-normal);
    opacity: var(--opacity-muted);
  }

  .pd__toggle {
    grid-area: toggle;
    justify-self: start;
    align-self: start;
    min-height: var(--size-control);
    padding: 0;
    color: inherit;
    background: none;
    border: none;
    font: inherit;
    font-size: var(--font-size-sm);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    cursor: pointer;
  }

  .pd__toggle:is(:hover, :focus-visible) {
    color: var(--t-accent);
  }

  .pd__info {
    grid-area: info;
    position: sticky;
    top: var(--space-8);
    align-self: start;
    display: grid;
    gap: var(--space-8);
    max-width: var(--layout-content-width);
  }

  .pd__back {
    justify-self: start;
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .pd__back:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .pd__name {
    display: grid;
    gap: var(--space-2);
  }

  .pd__price {
    font-size: var(--font-size-xl);
    font-variant-numeric: tabular-nums;
  }

  .pd__copy {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    font-family: var(--font-text);
    font-size: var(--font-size-base);
    font-size-adjust: var(--font-text-adjust);
    line-height: var(--font-leading-normal);
  }

  .pd__facts {
    border-top: var(--border-width) solid var(--color-rule);
  }

  .pd__order {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .pd__note {
    max-width: var(--measure);
    font-family: var(--font-text);
    font-size: var(--font-size-sm);
    font-size-adjust: var(--font-text-adjust);
    line-height: var(--font-leading-normal);
    opacity: var(--opacity-muted);
  }

  .pd__more {
    margin-top: var(--space-section);
  }

  .pd__more-title {
    width: min(100%, var(--layout-site-width));
    margin: 0 auto;
    padding-inline: var(--layout-gutter);
  }

  /* One column: the photo edge to edge, then name and price on one line, the rest below. */
  @media (max-width: 900px) {
    .pd {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "media"
        "toggle"
        "info";
      grid-template-rows: auto;
    }

    .pd__media {
      margin-inline: calc(0px - var(--layout-gutter));
      border-radius: 0;
    }

    .pd__info {
      position: static;
      max-width: none;
      gap: var(--space-6);
    }

    .pd__back {
      order: 1;
    }

    .pd__name {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2) var(--space-6);
    }
  }
</style>
