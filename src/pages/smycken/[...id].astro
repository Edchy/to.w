---
import { existsSync } from "node:fs";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/site/SiteFrame.astro";
import ProductCarousel from "../../components/home/ProductCarousel.astro";
import { CONTACT_EMAIL_HREF, RING_TRANSITION_CLASS, getProductSlug, ringTransitionName } from "../../config/site";
import "../../styles/pages.css";

export async function getStaticPaths() {
  const items = (await getCollection("jewelry")).sort((a, b) => b.data.date.localeCompare(a.data.date));
  return items.map((entry) => ({
    params: { id: getProductSlug(entry.id) },
    props: { entry, others: items.filter((item) => item.id !== entry.id) },
  }));
}

const { entry, others } = Astro.props;
const { title, kind, price, sizes, description, body, material, technique, design, images } = entry.data;

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const formattedPrice = new Intl.NumberFormat("sv-SE").format(price);

// A loose 3D model of the piece (scripts/make-rings.mjs), named by slug without diacritics.
const modelName = getProductSlug(entry.id).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
const hasModel = existsSync(`public/models/${modelName}.glb`);
const gallerySize = 6;
const realImages = images.slice(0, gallerySize);
const placeholderIndexes = Array.from({ length: Math.max(0, gallerySize - realImages.length) }, (_, index) => realImages.length + index);
const galleryCount = gallerySize + (hasModel ? 1 : 0);
const galleryId = `product-gallery-${modelName}`;

// Facts with a real value (the data has some blanks and "tba"s).
const clean = (value?: string) => (value?.trim() && value.trim() !== "tba" ? value.trim() : undefined);
const facts = [
  { term: "Material", value: clean(material) },
  { term: "Teknik", value: clean(technique) },
  { term: "Form", value: clean(design) },
  { term: sizes.length === 1 ? "Storlek" : "Storlekar", value: sizes.join(", ") || undefined },
].filter((fact) => fact.value);

// Search and link previews: the title says what the piece is, the description is cut at a sentence
// so it fits a result snippet (~155 characters), and previews show the real photo.
const pageTitle = kind ? `${title} – ${kind} i återvunnet silver` : title;
const summary = (text: string, max = 155) => {
  const sentences = text.match(/[^.!?]+[.!?]*/g) ?? [text];
  let out = "";
  for (const sentence of sentences) {
    if ((out + sentence).trim().length > max) break;
    out += sentence;
  }
  return (out || text.slice(0, max)).trim();
};
const metaDescription = summary(clean(description) ?? `${title}, handgjort smycke i återvunnet silver av Tove Wätte.`);
const photo = images[0] ? await getImage({ src: images[0], width: 1200, format: "jpg" }) : undefined;
const productUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: title,
  description: clean(description),
  image: photo ? new URL(photo.src, Astro.site).href : undefined,
  material: clean(material),
  brand: { "@type": "Brand", name: "To.W" },
  offers: {
    "@type": "Offer",
    url: productUrl,
    price,
    priceCurrency: "SEK",
    availability: "https://schema.org/MadeToOrder",
  },
};

// The order button opens a prefilled mail.
const sizeLine =
  sizes.length === 1 ? `Storlek / variant: ${sizes[0]}` : `Storlek / variant (välj: ${sizes.join(", ")}):`;
const orderBody = `Hej Tove,

Jag vill gärna beställa ${title} (${formattedPrice} kr).

${sizeLine}
Antal:
LEVERANS: [post / hämtas i ateljén / överlämning i Järna]
Adress, om post:
Telefon:
Övrigt:

Vänliga hälsningar,`;
const orderHref = `${CONTACT_EMAIL_HREF}?subject=${encodeURIComponent(`Beställning: ${title}`)}&body=${encodeURIComponent(orderBody)}`;
---

<BaseLayout bare title={pageTitle} description={metaDescription} image={photo?.src} imageAlt={`${title}, ${kind ?? "smycke"} i återvunnet silver`} jsonLd={jsonLd}>
  <SiteFrame>
    <div class="pg pd">
      <div class="pd__head">
        <a class="pd__back" href={`${baseUrl}smycken/`}>← alla smycken</a>

        <h1 class="pg__heading pd__title" style={`view-transition-name: ${ringTransitionName(getProductSlug(entry.id))}; view-transition-class: ${RING_TRANSITION_CLASS}`}>{title}</h1>
        <p class="pd__price">{formattedPrice} kr</p>
      </div>

      <div class="pd__stage">
        <div class="pd__gallery" data-product-gallery aria-label={`Bilder av ${title}`}>
          <div class="pd__viewport" id={galleryId} data-gallery-viewport tabindex="0">
            {realImages.map((image, index) => (
              <figure class="pd__slide pd__photo" data-gallery-slide hidden={index !== 0}>
                <Image
                  src={image}
                  alt={`${title}, ${kind ?? "smycke"} i återvunnet silver, bild ${index + 1}`}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 900px) 92vw, 48vw"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              </figure>
            ))}

            {placeholderIndexes.map((index) => (
              <div class="pd__slide pd__placeholder" data-gallery-slide hidden>
                <span>bild {index + 1}<br />kommer snart</span>
              </div>
            ))}

            {hasModel && (
              <div class="pd__slide pd__model-slide" data-gallery-slide hidden>
                <model-viewer
                  class="pd__model"
                  src={`${baseUrl}models/${modelName}.glb`}
                  alt={`3D-test av ${title}, ${kind ?? "smycke"} i återvunnet silver. Dra för att vrida.`}
                  camera-controls
                  disable-zoom
                  touch-action="pan-y"
                  min-camera-orbit="auto 0deg 130%"
                  max-camera-orbit="auto 180deg 130%"
                  camera-orbit="30deg 70deg 130%"
                  environment-image="neutral"
                  auto-rotate
                  auto-rotate-delay="0"
                  rotation-per-second="20deg"
                ></model-viewer>
                <p class="pd__model-note"><strong>3D-test.</strong> Vyn är ett pågående test och återger inte smyckets exakta form eller yta.</p>
              </div>
            )}
          </div>

          <div class="pd__gallery-nav">
            <div class="pd__gallery-arrows">
              <button type="button" data-gallery-prev aria-label="Föregående bild">←</button>
              <button type="button" data-gallery-next aria-label="Nästa bild">→</button>
            </div>
            <span data-gallery-counter>1 / {galleryCount}</span>
          </div>

          <div class="pd__thumbs" aria-label="Välj produktvy">
            {realImages.map((image, index) => (
              <button type="button" data-gallery-thumb={index} aria-label={`Visa bild ${index + 1}`} aria-current={index === 0 ? "true" : undefined}>
                <Image src={image} alt="" widths={[96, 192]} sizes="72px" loading="lazy" />
              </button>
            ))}
            {placeholderIndexes.map((index) => (
              <button class="pd__thumb-placeholder" type="button" data-gallery-thumb={index} aria-label={`Visa platshållare för bild ${index + 1}`}>
                {index + 1}
              </button>
            ))}
            {hasModel && (
              <button class="pd__thumb-model" type="button" data-gallery-thumb={gallerySize} aria-label="Visa 3D-test">
                3D
              </button>
            )}
          </div>
        </div>
      </div>

      <div class="pd__info">
        {clean(description) && <p class="pg__text">{clean(description)}</p>}
        {clean(body) && <p class="pg__text">{clean(body)}</p>}

        {facts.length > 0 && (
          <dl class="pg__ledger pd__facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.term}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <a class="pg__btn" href={orderHref}>Beställ via mejl →</a>
        <p class="pd__note">
          Smycket görs för hand efter din beställning. Jag återkommer med bekräftelse, betalningsinfo och
          ungefärlig leveranstid.
        </p>
      </div>
    </div>

    <section class="pd__more" aria-labelledby="more-title">
      <h2 class="pg__heading pd__more-title" id="more-title">Fler smycken</h2>
      <ProductCarousel items={others} />
    </section>
  </SiteFrame>
</BaseLayout>

<script>
  import "@google/model-viewer";

  document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]")];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")];
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => { slide.hidden = slideIndex !== current; });
      thumbs.forEach((thumb, thumbIndex) => {
        if (thumbIndex === current) thumb.setAttribute("aria-current", "true");
        else thumb.removeAttribute("aria-current");
      });
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    };

    thumbs.forEach((thumb, index) => thumb.addEventListener("click", () => show(index)));
    previous?.addEventListener("click", () => show(current - 1));
    next?.addEventListener("click", () => show(current + 1));
    viewport?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); show(current - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); show(current + 1); }
    });
  });

  // No turning on its own for visitors who ask for less motion; dragging still works.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const model of document.querySelectorAll("model-viewer[auto-rotate]")) model.removeAttribute("auto-rotate");
  }

  // In the one-column layout the frame is square and the ring comes closer to fill it.
  const oneColumn = matchMedia("(max-width: 900px)");
  const frame = () => {
    const radius = oneColumn.matches ? "105%" : "130%";
    for (const model of document.querySelectorAll("model-viewer")) {
      model.setAttribute("min-camera-orbit", `auto 0deg ${radius}`);
      model.setAttribute("max-camera-orbit", `auto 180deg ${radius}`);
      model.setAttribute("camera-orbit", `30deg 70deg ${radius}`);
    }
  };
  frame();
  oneColumn.addEventListener("change", frame);
</script>

<style>
  /* The name comes first in the page; on wide screens it sits in the right column above the text,
     with the ring beside both. */
  .pd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "stage head"
      "stage info";
    grid-template-rows: auto 1fr;
    gap: var(--space-6) var(--grid-gutter);
    align-items: start;
    padding-bottom: 0;
  }

  .pd__head {
    grid-area: head;
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-top: var(--space-16);
  }

  /* The ring alone on the page colour, like the product cards, a little larger. */
  .pd__stage {
    grid-area: stage;
    position: sticky;
    top: var(--space-8);
    min-width: 0;
  }

  .pd__gallery {
    display: grid;
    gap: var(--space-4);
  }

  .pd__viewport {
    position: relative;
    aspect-ratio: var(--ratio-product);
    overflow: hidden;
    background: color-mix(in oklch, currentColor 4%, transparent);
  }

  .pd__viewport:focus-visible {
    outline: var(--border-width-thick) solid currentColor;
    outline-offset: var(--space-1);
  }

  .pd__slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .pd__slide[hidden] {
    display: none;
  }

  .pd__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd__placeholder {
    display: grid;
    place-items: center;
    color: color-mix(in oklch, currentColor 65%, transparent);
    background:
      linear-gradient(to bottom right, transparent calc(50% - 0.5px), var(--color-rule-subtle) 50%, transparent calc(50% + 0.5px)),
      color-mix(in oklch, currentColor 3%, transparent);
    border: var(--border-width) solid var(--color-rule-subtle);
    font-family: var(--font-text);
    font-size: var(--font-size-sm);
    font-style: italic;
    line-height: var(--font-leading-normal);
    text-align: center;
  }

  .pd__model-slide {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .pd__model {
    --poster-color: transparent;

    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .pd__model:active {
    cursor: grabbing;
  }

  .pd__model-note {
    margin: 0;
    padding: var(--space-4);
    border-top: var(--border-width) solid var(--color-rule);
    font-family: var(--font-text);
    font-size: var(--font-size-sm);
    font-size-adjust: var(--font-text-adjust);
    line-height: var(--font-leading-normal);
  }

  .pd__gallery-nav,
  .pd__gallery-arrows {
    display: flex;
    align-items: center;
  }

  .pd__gallery-nav {
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }

  .pd__gallery-arrows {
    gap: var(--space-2);
  }

  .pd__gallery-arrows button,
  .pd__thumbs button {
    padding: 0;
    color: inherit;
    background: transparent;
    border: var(--border-width) solid var(--color-rule);
    border-radius: var(--radius);
    font: inherit;
    cursor: pointer;
  }

  .pd__gallery-arrows button {
    display: grid;
    place-items: center;
    width: var(--size-control);
    height: var(--size-control);
  }

  .pd__gallery-arrows button:is(:hover, :focus-visible),
  .pd__thumbs button:is(:hover, :focus-visible),
  .pd__thumbs button[aria-current="true"] {
    color: var(--t-page, var(--off-white));
    background: var(--t-fg, var(--neutral-950));
    outline: none;
  }

  .pd__thumbs {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .pd__thumbs button {
    aspect-ratio: 1;
    overflow: hidden;
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }

  .pd__thumbs button[aria-current="true"] {
    border-color: currentColor;
    border-width: var(--border-width-thick);
  }

  .pd__thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd__thumb-placeholder,
  .pd__thumb-model {
    display: grid;
    place-items: center;
  }

  .pd__info {
    grid-area: info;
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .pd__back {
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .pd__back:hover,
  .pd__back:focus-visible {
    text-decoration: underline;
  }

  .pd__title {
    margin-top: var(--space-6);
  }

  .pd__price {
    margin-top: calc(0px - var(--space-2));
    font-size: var(--font-size-xl);
    font-variant-numeric: tabular-nums;
  }

  .pd__facts {
    justify-self: stretch;
    max-width: var(--layout-content-width);
    border-top: var(--border-width) solid var(--color-rule);
  }

  .pd__note {
    max-width: var(--measure);
    font-family: var(--font-text);
    font-size: var(--font-size-sm);
    font-size-adjust: var(--font-text-adjust);
    line-height: var(--font-leading-normal);
  }

  .pd__more {
    margin-top: var(--space-section);
  }

  .pd__more-title {
    width: min(100%, var(--layout-site-width));
    margin: 0 auto;
    padding-inline: var(--layout-gutter);
  }

  @media (max-width: 900px) {
    /* One column: name and price, then the ring, then the text. */
    .pd {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "stage"
        "info";
      grid-template-rows: auto;
    }

    .pd__head {
      padding-top: 0;
    }

    /* A flat ring needs no tall frame: square, so the text starts sooner. */
    .pd__stage {
      position: static;
      width: min(100%, 28rem);
      justify-self: center;
    }

    .pd__viewport {
      aspect-ratio: 1;
    }

    .pd__thumbs {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .pd__thumbs button {
      flex: 0 0 var(--size-control);
    }
  }
</style>
