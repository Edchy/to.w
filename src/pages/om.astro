---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/img/hero.avif";
import { CONTACT_EMAIL_HREF } from "../config/site";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => {
  const url = `${baseUrl}${path.replace(/^\//, "")}`;
  return /\.[a-z0-9]+$/i.test(url) || url.endsWith("/") ? url : `${url}/`;
};
---

<BaseLayout
  title="Om"
  description="Om Tove Wätte — handgjorda smycken i återvunnet silver och stickade objekt, från ateljén i Järna."
>
  <article class="about" aria-labelledby="about-title">
    <h1 class="sr-only" id="about-title">Om</h1>

    <section class="about__intro" aria-label="Om Tove Wätte">
      <div class="about__portrait">
        <Image
          src={heroImg}
          alt="Tove Wätte håller händerna framför ansiktet och bär flera silverringar."
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="about__intro-content">
        <div class="about__copy">
          <p class="about__lead">Jag heter Tove Wätte och arbetar med smycken i återvunnet silver.</p>
          <p>Jag tycker om enkla former som får vara lite ojämna och där det syns att smycket är gjort för hand.</p>
          <p>De flesta former börjar i hårt vax. Jag skär, bygger och provar mig fram innan modellen gjuts i silver och bearbetas för hand. Därför blir inget exemplar helt identiskt med nästa.</p>
        </div>

        <p class="about__location">Järna, Sverige</p>
      </div>
    </section>

    <section class="about__closing" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">Något att bära  eller göra tillsammans</h2>
        <p>Du kan beställa ett befintligt smycke via mejl, komma på en kurs eller höra av dig om en egen idé.</p>
      </div>
      <nav class="about__paths" aria-label="Gå vidare">
        <a href={withBase("/smycken")}>Se smycken</a>
        <a href={withBase("/kurser")}>Kom på kurs</a>
        <a href={CONTACT_EMAIL_HREF}>Skriv till mig</a>
        <a href="https://instagram.com/tovewatte" target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--layout-site-width);
    margin: 0 auto;
    padding: var(--space-8) var(--layout-gutter) var(--space-24);
    display: grid;
    gap: var(--space-32);
  }

  .about__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: var(--grid-gutter);
    align-items: start;
  }

  .about__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .about__intro-content {
    display: grid;
    gap: var(--space-16);
    position: sticky;
    top: var(--space-8);
  }

  .about__copy {
    display: grid;
    gap: var(--space-5);
    max-width: var(--layout-content-width);
  }

  .about__copy p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--font-leading-relaxed);
  }

  .about__copy .about__lead {
    color: var(--color-text-primary);
    font-family: var(--font-heading-text);
    font-size: var(--font-size-xl);
    line-height: var(--font-leading-snug);
  }

  .about__location {
    width: fit-content;
    padding-top: var(--space-5);
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border-default);
  }

  .about__closing h2 {
    max-width: var(--layout-content-width);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--font-leading-tight);
    letter-spacing: var(--font-tracking-negative);
  }

  .about__closing p {
    max-width: var(--layout-content-width);
    color: var(--color-text-secondary);
    line-height: var(--font-leading-relaxed);
  }

  .about__closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--grid-gutter);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border-default);
  }

  .about__closing > div {
    display: grid;
    gap: var(--space-5);
  }

  .about__paths {
    display: grid;
  }

  .about__paths a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border-default);
  }

  .about__paths a::after {
    content: "→";
  }

  @media (hover: hover) {
    .about a:hover {
      color: var(--color-accent);
    }
  }

  @media (max-width: 1024px) {
    .about__intro {
      grid-template-columns: 1fr;
    }

    .about__intro-content {
      position: static;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

  }

  @media (max-width: 700px) {
    .about {
      padding-top: var(--space-6);
      padding-bottom: var(--space-16);
      gap: var(--space-20);
    }

    .about__intro,
    .about__intro-content,
    .about__closing {
      grid-template-columns: 1fr;
    }

    .about__intro {
      gap: var(--space-8);
    }

    .about__intro-content {
      gap: var(--space-10);
    }

    .about__closing {
      gap: var(--space-6);
    }
  }
</style>
