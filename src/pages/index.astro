---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectionSwitcher from "../components/home-studies/DirectionSwitcher.astro";
import FieldNotebook from "../components/home-studies/FieldNotebook.astro";
import PrintedPoster from "../components/home-studies/PrintedPoster.astro";
import WorkingCatalogue from "../components/home-studies/WorkingCatalogue.astro";
import handsCutout from "../assets/img/studies/besthero-hands-cutout-study-v1.png";

const jewelry = (await getCollection("jewelry")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout
  bare
  description="Designstudier för Tove Wättes nya webbplats."
>
  <DirectionSwitcher />
  <FieldNotebook items={jewelry} />
  <PrintedPoster items={jewelry} />
  <WorkingCatalogue items={jewelry} />
  <article class="assembly" data-direction-panel="assembly" hidden>
    <header class="assembly__header">
      <a class="assembly__wordmark" href={baseUrl}>towtow</a>
      <nav aria-label="Huvudnavigering">
        <a href={withBase("/smycken")}>smycken</a>
        <a href={withBase("/kurser")}>kurser</a>
        <a href={withBase("/om")}>om</a>
      </nav>
    </header>

    <section class="assembly__hero">
      <Image
        class="assembly__hands"
        src={handsCutout}
        alt="Händer med flera handgjorda silverringar."
        loading="eager"
        fetchpriority="high"
      />
    </section>
  </article>
</BaseLayout>

<style>
  .assembly {
    min-height: 100svh;
    overflow-x: clip;
    color: var(--study-ink);
    background-color: var(--study-paper);
    background-image: var(--study-paper-texture);
    font-family: var(--font-study-sans);
  }

  .assembly__header {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding: var(--space-lg) var(--layout-gutter);
  }

  .assembly__header a {
    color: inherit;
    text-decoration: none;
  }

  .assembly__wordmark {
    font-family: var(--font-study-labrada);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-negative);
  }

  .assembly__header nav {
    display: flex;
    gap: var(--space-lg);
    padding-right: var(--space-32);
  }

  .assembly__hero {
    position: relative;
    min-height: calc(100svh - var(--space-24));
    overflow: visible;
  }

  .assembly__hero :global(img.assembly__hands) {
    position: absolute;
    top: calc(0px - var(--space-24) - var(--space-12));
    right: var(--layout-gutter);
    width: min(64vw, 70rem);
    height: auto;
    object-fit: contain;
    filter: sepia(0.18) saturate(1.25) hue-rotate(165deg);
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .assembly__header nav {
      padding-right: 0;
    }

    .assembly__hero :global(img.assembly__hands) {
      right: calc(0px - var(--space-6));
      width: 78vw;
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .assembly__header {
      align-items: center;
      padding-block: var(--space-md);
    }

    .assembly__header nav {
      gap: var(--space-md);
      padding-right: 0;
    }

    .assembly__hero :global(img.assembly__hands) {
      top: calc(0px - var(--space-32));
      right: calc(0px - var(--space-8));
      width: clamp(34rem, 112vw, 44rem);
      max-width: none;
      transform: none;
    }
  }

  @media (max-width: 380px) {
    .assembly__header {
      align-items: start;
    }

    .assembly__header nav {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>

<script is:inline>
  const buttons = [...document.querySelectorAll("[data-direction-button]")];
  const panels = [...document.querySelectorAll("[data-direction-panel]")];
  const validDirections = panels.map((panel) => panel.dataset.directionPanel);

  function activateDirection(direction, updateUrl = true) {
    const selected = validDirections.includes(direction) ? direction : "field";

    buttons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.directionButton === selected),
      );
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.directionPanel !== selected;
    });

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("direction", selected);
      history.replaceState({}, "", url);
    }

    window.scrollTo({ top: 0, behavior: "auto" });
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      activateDirection(button.dataset.directionButton);
    });
  });

  const initialDirection = new URL(window.location.href).searchParams.get("direction");
  activateDirection(initialDirection, false);
</script>
