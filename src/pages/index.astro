---
// The homepage: the ring with the line under it like a caption. /v2/ is the same page with the
// split hero.
import VFrame from "../components/v/VFrame.astro";
import Home from "../components/v/Home.astro";
import { getPieces } from "../components/v/catalog";

const pieces = await getPieces();

const site = Astro.site?.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site}#website`, url: site, name: "TO·W", inLanguage: "sv" },
    {
      "@type": "Person",
      "@id": `${site}#tove`,
      name: "Tove Wätte",
      url: site,
      sameAs: ["https://instagram.com/tovewatte"],
    },
  ],
};
---

<VFrame
  description="Handgjorda smycken i återvunnet sterling silver av Tove Wätte i Järna. Ringar och hängen efter beställning, och kurser där du formar din egen ring."
  jsonLd={jsonLd}
>
  <Home pieces={pieces} hero="ring-caption" />
</VFrame>
