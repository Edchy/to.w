---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getProductSlug } from "../config/site";
import { openOccasions } from "../data/courses";

const works = (await getCollection("jewelry")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout description="to.w är Tove Wättes samlade plats för handgjorda smycken i silver och bilder från arbetet.">
  <div class="home">
    <h1 class="sr-only">Tove Wätte — handgjorda smycken</h1>

    {openOccasions.length > 0 && (
      <p class="home__notice">
        {openOccasions.map(({ course, date }, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={withBase(`/kurser#anmalan-${date.slug}`)}>
              {course.title} — {date.date}
            </a>
          </>
        ))}
      </p>
    )}

    <section class="work-grid" aria-label="Verk">
      {works.map((entry, i) => {
        const productSlug = getProductSlug(entry.id);
        return (
          <a class="work" href={withBase(`/smycken/${productSlug}`)}>
            <div class="work__media" transition:name={`product-${productSlug}`}>
              <Image
                src={entry.data.images[0]}
                alt={entry.data.title}
                loading={i < 8 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                width={720}
                height={900}
              />
            </div>
            <h2
              class="work__title"
              transition:name={`product-title-${productSlug}`}
              transition:animate="none"
            >
              {entry.data.title}
            </h2>
          </a>
        );
      })}
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--layout-site-width);
    margin: 0 auto;
    padding: 0 var(--layout-gutter) var(--space-16);
  }

  /* Course notice — plain text, no card, no eyebrow. */
  .home__notice {
    margin: 0 0 var(--space-16);
    font-size: var(--font-size-sm);
    letter-spacing: var(--font-tracking-wide);
    color: var(--color-text-secondary);
  }

  .home__notice a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .home__notice a:hover {
    color: var(--color-accent);
  }

  /* ── Work grid ── */

  .work-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--grid-row-gap);
  }

  .work {
    display: block;
    color: inherit;
  }

  .work__media {
    height: clamp(220px, 26vw, 400px);
    overflow: hidden;
  }

  .work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--transition-slow);
  }

  @media (hover: hover) {
    .work:hover .work__media img {
      transform: scale(1.04);
    }
  }

  .work__title {
    margin-top: var(--space-3);
    font-family: var(--font-body-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-wide);
    text-transform: lowercase;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .work:hover .work__title {
    color: var(--color-text-primary);
  }

  @media (max-width: 1024px) {
    .work-grid {
      --grid-columns: 3;
    }
  }

  @media (max-width: 760px) {
    .work-grid {
      --grid-columns: 2;
    }
  }
</style>
