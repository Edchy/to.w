---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import gazaPoster from "../assets/img/gaza/v-gaza-poster.jpg";
import gazaVideo from "../assets/img/gaza/v-gaza.web.mp4";
import d1handImg from "../content/gallery/d1hand.avif";
import typ1Img from "../content/gallery/typ1.avif";

const gazaReelUrl = "https://www.instagram.com/reel/DRMmx_ODFXL/?igsh=MTEwdzV6d3Frc3F5ZQ==";
---

<BaseLayout
  noindex
  title="Projekt"
  description="Samarbeten och projekt av Tove Wätte — halsbandet till förmån för Rädda Barnen och knutringen för Barndiabetesfonden."
>
  <div class="projects">
    <h1 class="sr-only">Projekt</h1>

    <article class="project">
      <div class="project__media">
        <video
          class="project__video"
          src={gazaVideo}
          poster={gazaPoster.src}
          aria-label="Gaza-halsbandet"
          playsinline
          controls
          preload="none"
        ></video>
      </div>
      <div class="project__text">
        <h2 class="project__heading">rädda barnen</h2>
        <p>Det här halsbandet är framtaget till förmån för Rädda Barnen och deras livsviktiga arbete för människor i Gaza.</p>
        <p>Det är graverat på återvunnet sterling silver och är ett samarbete mellan mig och <a href="https://www.instagram.com/vtelegin" target="_blank" rel="noopener noreferrer">Viktor Telegin</a>. Jag skapade 20 stycken halsband efter en ritning av Viktor.</p>
        <p>Alla intäkter från försäljningen gick till Rädda Barnen och deras insatser för att skydda, stödja och ge barn möjlighet till trygghet, vård och framtidshopp i en mycket utsatt situation. <a href={gazaReelUrl} target="_blank" rel="noopener noreferrer">Se video</a></p>
      </div>
    </article>

    <article class="project">
      <div class="project__media project__media--pair">
        <Image src={typ1Img} alt="Typ Ett-ringen" loading="lazy" width={640} height={800} />
        <Image src={d1handImg} alt="D1-ringen på ett barns hand" loading="lazy" width={640} height={800} />
      </div>
      <div class="project__text">
        <h2 class="project__heading">knuten</h2>
        <p>Jag har haft äran att samarbeta med <a href="https://webbshop.barndiabetesfonden.se/produkter/knut-ring-silver" target="_blank" rel="noopener noreferrer">Barndiabetesfonden</a> genom att designa och skapa en tunn ring med en knut placerad högst upp. Ringen säljs via deras hemsida och alla intäkter går oavkortat till forskning om diabetes.</p>
        <p>Projektet ligger mig varmt om hjärtat — jag är förälder till ett barn med diabetes, som insjuknade innan sin 1-års dag.</p>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .projects {
    max-width: var(--layout-site-width);
    margin: 0 auto;
    padding: 0 var(--layout-gutter) var(--space-16);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--grid-gutter);
    align-items: start;
  }

  .project + .project {
    margin-top: clamp(var(--space-24), 10vw, var(--space-48));
  }

  .project__media--pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .project__media img,
  .project__video {
    width: 100%;
    height: auto;
  }

  .project__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--layout-content-width);
  }

  .project__heading {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--font-tracking-negative);
    text-transform: lowercase;
  }

  .project__text p {
    font-size: var(--font-size-base);
    line-height: var(--font-leading-normal);
    color: var(--color-text-secondary);
  }

  .project__text a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .project__text a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 700px) {
    .project {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }
  }
</style>
