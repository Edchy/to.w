---
// Where the course interest form lands after sending (live and in the studies alike). Kept out of
// search results.
import VFrame from "../../components/v/VFrame.astro";
import { vHref } from "../../components/v/catalog";
---

<VFrame v="live" title="Tack" page="kurser" description="Tack för din intresseanmälan till kursen." noindex>
  <div class="v-wrap v-thanks">
    <h1 class="v-thanks__title">Tack, din anmälan är skickad.</h1>
    <p>Jag hör av mig via mejl med bekräftelse och praktiska detaljer.</p>
    <a class="v-btn" href={vHref("live", "kurser")}>← Tillbaka till kurser</a>
  </div>
</VFrame>

<style>
  .v-thanks {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: var(--space-6);
    min-height: 60svh;
    padding-block: var(--space-16);
  }

  .v-thanks__title {
    font-family: var(--v-display);
    font-size: var(--v-size-hero-split);
    font-weight: var(--font-weight-regular);
    line-height: var(--v-leading-solid);
  }
</style>
