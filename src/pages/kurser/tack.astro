---
import BaseLayout from "../../layouts/BaseLayout.astro";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const coursesUrl = `${baseUrl}kurser/`;
---

<BaseLayout title="Tack" description="Tack för din intresseanmälan till kursen.">
  <section class="reset-shell">
    <h1>Tack</h1>
    <p>Din intresseanmälan är skickad. Jag hör av mig via mejl.</p>
    <a href={coursesUrl}>Tillbaka till kurser</a>
  </section>
</BaseLayout>
