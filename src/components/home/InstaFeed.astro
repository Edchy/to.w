---
// The homepage Instagram section: a heading, a short line, the follow link and a grid of posts.
// Every photo links to the profile.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import trattoria from "../../assets/img/instagram/trattoria.jpg";
import sheep from "../../assets/img/instagram/sheep.jpg";
import flower from "../../assets/img/instagram/flower.jpg";
import blur from "../../assets/img/instagram/blur.jpg";
import chair from "../../assets/img/illustrations/chair.webp";
import wateringCan from "../../assets/img/illustrations/watering-can.webp";

const titleId = "ig-title";
const profileUrl = "https://instagram.com/tovewatte";
const posts: { src: ImageMetadata; alt: string; decor?: "chair" | "can" }[] = [
  { src: trattoria, alt: "En gul bil framför en trattoria." },
  { src: sheep, alt: "Två får som betar hö." },
  { src: flower, alt: "En hand med silverring håller en gul blomma mot svart bakgrund.", decor: "can" },
  { src: blur, alt: "En suddig hand håller upp en silverring mot en vit vägg.", decor: "chair" },
];
---

<section class="ig" aria-labelledby={titleId}>
  <div class="ig__head">
    <h2 id={titleId}>Instagram</h2>
    <p>Nya smycken, kursdatum och glimtar från livet runt omkring.</p>
    <a href={profileUrl}>@tovewatte</a>
  </div>

  <ul class="ig__grid">
    {posts.map((post) => (
      <li>
        <a href={profileUrl} tabindex="-1" aria-hidden="true">
          <Image src={post.src} alt={post.alt} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 25vw" loading="lazy" />
        </a>
        {post.decor === "chair" && (
          <Image class="ig__chair" src={chair} alt="" aria-hidden="true" widths={[240, 480]} sizes="8rem" loading="lazy" />
        )}
        {post.decor === "can" && (
          <Image class="ig__can" src={wateringCan} alt="" aria-hidden="true" widths={[320, 640]} sizes="14rem" loading="lazy" />
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .ig {
    color: var(--t-insta-fg, inherit);
    background: var(--t-insta-bg, transparent);
    padding: var(--space-24) max(var(--layout-gutter), calc((100% - var(--layout-site-width)) / 2));
  }

  /* Heading on its own row; the line and the handle share the row beneath, on one baseline. */
  .ig__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-md) var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .ig h2 {
    grid-column: 1 / -1;
  }

  .ig h2 {
    margin: 0;
    font-family: var(--t-display, var(--font-display));
    font-size: var(--study-type-catalogue-note);
    font-weight: var(--font-weight-regular);
    line-height: var(--font-leading-statement);
    letter-spacing: var(--font-tracking-negative);
  }

  .ig__head p {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .ig__head a {
    color: var(--t-accent, var(--study-pink));
    font-size: var(--font-size-lg);
    white-space: nowrap;
  }

  .ig__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ig__grid li {
    position: relative;
  }

  .ig__grid a {
    display: block;
  }

  /* The cobalt watering can hovers above the flower photo, tipped so its drops fall on the flower. */
  .ig__grid :global(img.ig__can) {
    position: absolute;
    z-index: var(--z-raised);
    top: -24%;
    left: -10%;
    width: 72%;
    height: auto;
    aspect-ratio: auto;
    border-radius: 0;
    rotate: 22deg;
    pointer-events: none;
  }

  /* The cobalt chair sits in the last photo's bottom-right corner, its legs over the bottom edge.
     The drawing fills only the middle half of its image, hence the large width. */
  .ig__grid :global(img.ig__chair) {
    position: absolute;
    right: 0;
    bottom: -16%;
    width: 55%;
    height: auto;
    aspect-ratio: auto;
    border-radius: 0;
    rotate: -4deg;
    pointer-events: none;
  }

  /* On hover the whole photo grows slightly, frame and all. */
  .ig__grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition: scale var(--transition-slow);
  }

  @media (hover: hover) {
    .ig__grid a:hover :global(img) {
      scale: 1.02;
    }
  }

  @media (max-width: 700px) {
    .ig {
      padding-block: var(--space-16);
    }

    .ig__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }

    /* On phones the flower sits in the second row, so the can stays low enough to clear the photo above. */
    .ig__grid :global(img.ig__can) {
      top: -12%;
      left: -6%;
      width: 62%;
    }
  }
</style>
