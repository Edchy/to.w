---
// The homepage: hero (hands + woven headline + ring annotations), products, courses, Instagram.
// The header, theme switcher and footer come from the site frame.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import handsCutout from "../../assets/img/hero/hands.webp";
import SiteFrame from "../site/SiteFrame.astro";
import ProductCarousel from "./ProductCarousel.astro";
import CoursesTeaser from "./CoursesTeaser.astro";
import InstaFeed from "./InstaFeed.astro";

type Props = { items: CollectionEntry<"jewelry">[] };
const { items } = Astro.props;

// The headline is set letter by letter, each character numbered 1–26 across the three lines, so each
// breakpoint can pick exactly which letters sit in front of the fingers (see the end of <style>).
const title = "HANDGJORDA SMYCKEN I SILVER.";
const titleRows = ["HANDGJORDA", "SMYCKEN", "I SILVER."];
const rowStarts = titleRows.map((_, i) => titleRows.slice(0, i).join("").length + 1);

// Hand-drawn loops and stems use layered strokes to keep the original uneven pen pressure.
const loopRight = "M 162 18 C 120 2 44 4 16 30 C -4 50 8 84 60 94 C 116 104 186 92 196 58 C 204 28 170 8 118 6 C 80 4 40 12 28 22";
const loopLeft = "M 30 80 C 60 100 160 102 190 70 C 212 44 176 6 110 4 C 50 2 2 22 6 52 C 10 80 60 92 120 88 C 150 86 176 76 186 62";
const stemRight = "M 10 0 C 6 90 15 180 13.5 300 C 12 420 4 480 5.5 610 C 7 740 16 820 13.5 900 C 11.5 950 10 980 10 1000";
const stemLeft = "M 10 0 C 14 110 5 210 6.5 340 C 8 470 16 560 14.5 690 C 13 800 5.5 880 7.5 950 C 8.5 975 10 990 10 1000";
---

<SiteFrame>
  <section class="a10__hero">
    <h1 aria-label={title}>
        {titleRows.map((row, r) => (
          <span class="a10__row" aria-hidden="true">
            {[...row].map((char, i) => {
              const n = rowStarts[r] + i;
              const accent = r === 2 && i >= 2 && char !== "." ? " a10__accent" : "";
              return <span class={`a10__l a10__l${n}${accent}`} data-n={n}>{char}</span>;
            })}
          </span>
        ))}
    </h1>

    <div class="a10__hands">
      <Image
        src={handsCutout}
        alt="Händer med flera handgjorda silverringar."
        loading="eager"
        fetchpriority="high"
      />

      <svg class="a10__line" viewBox="0 0 1512 1040" aria-hidden="true">
        <circle cx="1258" cy="336" r="9" />
        <circle cx="982" cy="408" r="9" />
      </svg>

      <span class="a10__label a10__label--right">
        <span class="a10__label-name">handmade</span>
        <svg class="a10__stem" viewBox="0 0 20 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="a10__stem-base" d={stemRight} />
          <path class="a10__stem-press" d={stemRight} pathLength="100" />
        </svg>
        <svg class="a10__loop" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="a10__loop-base" d={loopRight} />
          <path class="a10__loop-press" d={loopRight} pathLength="100" />
          <path class="a10__loop-peak" d={loopRight} pathLength="100" />
        </svg>
      </span>

      <span class="a10__label a10__label--left">
        <span class="a10__label-name">recycled</span>
        <svg class="a10__stem" viewBox="0 0 20 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="a10__stem-base" d={stemLeft} />
          <path class="a10__stem-press" d={stemLeft} pathLength="100" />
        </svg>
        <svg class="a10__loop" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="a10__loop-base" d={loopLeft} />
          <path class="a10__loop-press" d={loopLeft} pathLength="100" />
          <path class="a10__loop-peak" d={loopLeft} pathLength="100" />
        </svg>
      </span>
    </div>
  </section>

  <ProductCarousel items={items} homepage />

  <CoursesTeaser />
  <InstaFeed />
</SiteFrame>

<style>
  /*
   * The hero: a left-aligned three-line headline with the hands hanging into it from the top. These
   * are fallbacks; the real geometry is set per breakpoint further down (--h-size, --hands-w,
   * --hands-left, --h-top), and the letter-by-letter layering at the end of <style> decides which
   * letters sit in front of the fingers.
   */
  .a10__hero {
    --hands-top: calc(0px - var(--space-12));
    --h-size: 8vw;
    --h-top: 18vw;
    --hands-w: 58vw;
    --hands-left: 25vw;

    isolation: isolate;

    /* A full screen: the product strip only appears once you scroll. */
    width: min(100%, var(--layout-site-width));
    min-height: 100svh;
    margin-inline: auto;
    padding: calc(var(--h-top) + var(--hands-top)) var(--layout-gutter) var(--space-4);
  }

  .a10__hero {
    --hero-font: "Nyght Serif", Georgia, serif;
    --hero-weight: 700;
    --hero-style: italic;
    --hero-tracking: var(--font-tracking-tight);
    --hero-blend: normal;
  }

  .a10__hero h1 {
    margin: 0;
    font-size: var(--h-size);
    line-height: var(--font-leading-display);
  }

  .a10.a10 .a10__hero h1 {
    font-family: var(--hero-font);
    font-weight: var(--hero-weight);
    font-style: var(--hero-style);
    letter-spacing: var(--hero-tracking);
    color: var(--t-hero-fg, var(--pure-white));
  }

  .a10.a10 .a10__hero .a10__l {
    mix-blend-mode: var(--hero-blend);
  }

  .a10.a10 .a10__hero .a10__accent {
    color: inherit;
  }

  .a10__hero h1 > span {
    display: block;
  }

  /* Test: "silver" picked out in pink. */
  .a10__accent {
    color: var(--t-accent);
  }

  .a10__hands {
    position: absolute;
    z-index: var(--z-base);
    top: var(--hands-top);
    left: var(--hands-left);
    width: var(--hands-w);
  }

  .a10__hands :global(img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .a10__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--t-annotation, var(--pure-black));
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .a10__line circle {
    fill: var(--t-annotation, var(--pure-black));
    stroke: none;
  }

  .a10__label {
    position: absolute;
    display: grid;
    justify-items: center;
    font-family: var(--t-body);
    font-weight: var(--font-weight-medium);
    color: var(--t-annotation, var(--pure-black));
    font-size: var(--font-size-sm);
    white-space: nowrap;
    translate: -50% 0;
  }

  .a10__label-name {
    position: relative;
    z-index: var(--z-raised);
    font-size: var(--font-size-base);
    line-height: var(--font-leading-tight);
  }

  .a10__loop {
    position: absolute;
    top: -0.8em;
    left: -1.1em;
    width: calc(100% + 2.2em);
    height: calc(100% + 1.6em);
    overflow: visible;
    fill: none;
    stroke: var(--t-annotation, var(--pure-black));
    stroke-linecap: round;
    pointer-events: none;
  }

  .a10__loop-base {
    stroke-width: 2.4;
  }

  .a10__loop-press {
    stroke-width: 4.2;
    stroke-dasharray: 0 8 34 58;
  }

  .a10__loop-peak {
    stroke-width: 5.8;
    stroke-dasharray: 0 16 14 70;
  }

  .a10__label--left .a10__loop-press {
    stroke-dasharray: 0 50 32 18;
  }

  .a10__label--left .a10__loop-peak {
    stroke-dasharray: 0 58 12 30;
  }

  .a10__label--right .a10__loop {
    rotate: -4deg;
  }

  .a10__label--left .a10__loop {
    rotate: 3deg;
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .a10__label-name {
      font-size: var(--font-size-sm);
    }
  }

  /* ═══ Colour themes ════════════════════════════════════════════════════════════
   * The palettes live in the site frame; the homepage only adjusts its own parts per theme.
   */

  .a10.a10--ren .a10__hero h1 {
    color: var(--pure-black);
  }

  .a10.a10--ren :global(:is(.ct__book, .ct__slider-nav button):is(:hover, :focus-visible)) {
    background: var(--t-btn-bg);
    opacity: var(--opacity-muted);
  }

  .a10.a10--ren :global(.pc__controls button:hover:not(:disabled)) {
    color: var(--t-btn-fg);
    background: var(--t-btn-bg);
  }

  /* Relief uses white type over the hero. */
  .a10.a10--relief .a10__hero h1 {
    color: var(--t-hero-fg);
  }

  .a10.a10--relief .a10__hero .a10__accent {
    color: inherit;
  }

  /*
   * Sentences (course intro, empty-state line, workshop offer, Instagram intro) in EB Garamond.
   * Keep the text scale explicit for the supporting copy.
   */
  .a10.a10--jost :global(:is(.ct__body, .ct__private, .courses-empty, .ig__head p)) {
    font-family: var(--font-text);
    font-size-adjust: var(--font-text-adjust);
  }

  /*
   * @tovewatte is the section's real call to action, so it is set exactly like the "Instagram"
   * title and shares its row (title left, handle right); the intro runs underneath.
   */
  .a10.a10--jost :global(.ig__head h2) {
    grid-column: 1;
  }

  .a10.a10--jost :global(.ig__head a) {
    position: relative;
    grid-row: 1;
    grid-column: 2;
    font-family: var(--t-display);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    line-height: var(--font-leading-display);
    letter-spacing: var(--font-tracking-tight);
    color: inherit;
    text-decoration: none;
  }

  /* On hover the nav's hand-drawn oval (see SiteFrame's aria-current) fades in around the handle. */
  .a10.a10--jost :global(.ig__head a)::before,
  .a10.a10--jost :global(.ig__head a)::after {
    position: absolute;
    content: "";
    pointer-events: none;
    border: var(--border-width-thick) solid currentColor;
    border-radius: var(--radius-full);
    opacity: 0;
    transition: opacity var(--transition-normal), rotate var(--transition-normal);
  }

  .a10.a10--jost :global(.ig__head a)::before {
    inset: calc(-1 * var(--space-2)) calc(-1 * var(--space-4));
    rotate: -1deg;
  }

  .a10.a10--jost :global(.ig__head a)::after {
    inset: calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) calc(-1 * var(--space-4)) calc(-1 * var(--space-4));
    rotate: 1deg;
  }

  .a10.a10--jost :global(.ig__head a:is(:hover, :focus-visible))::before {
    opacity: 1;
    rotate: -3deg;
  }

  .a10.a10--jost :global(.ig__head a:is(:hover, :focus-visible))::after {
    opacity: var(--opacity-muted);
    rotate: 2deg;
  }

  .a10.a10--jost :global(.ig__head p) {
    grid-column: 1 / -1;
  }

  /*
   * From 701px the handle follows you down the section: the header block dissolves so the title,
   * intro and photos share one grid with the handle, which spans every row of the right-hand column
   * and sticks near the top of the screen until the photos end.
   */
  @media (min-width: 701px) {
    .a10.a10--jost :global(.ig) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-4) var(--space-8);
    }

    .a10.a10--jost :global(.ig__head) {
      display: contents;
    }

    .a10.a10--jost :global(.ig__head h2) {
      grid-row: 1;
    }

    .a10.a10--jost :global(.ig__head p) {
      grid-row: 2;
      grid-column: 1;
      margin-bottom: var(--space-8);
    }

    .a10.a10--jost :global(.ig__head a) {
      position: sticky;
      top: var(--space-6);
      grid-row: 1 / 4;
      align-self: start;
    }

    .a10.a10--jost :global(.ig__grid) {
      grid-row: 3;
      grid-column: 1;
    }
  }

  /* The products take a full section's room above them, the same as below. */
  .a10.a10--jost :global(.pc) {
    padding-top: var(--space-section);
  }

  /* The rings sit without mood backgrounds, so the ring's shadow
     sits on the flat section colour; it is softened to half strength there. */
  .a10.a10--jost :global(.pc__frame img.pc__ring) {
    filter: drop-shadow(var(--shadow-object-soft));
  }

  .a10--supreme :global(.ct) {
    --t-accent: var(--supreme-red);
    --t-btn-bg: var(--supreme-red);
    --t-btn-fg: var(--pure-white);
  }

  /* Instagram as a 2×2 grid of larger photos. */
  @media (min-width: 701px) {
    .a10--jost :global(.ig__grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 60rem;
    }
  }

  /* Narrower product cards, so more rings show at once. */
  .a10--jost :global(.pc__card) {
    --card-w: clamp(12rem, 17vw, 17rem);
  }

  /* Keep the original ring-to-label geometry tied to the rendered hand width. */
  .a10 .a10__hero {
    --hw: var(--hands-w);
  }

  .a10 .a10__stem {
    position: absolute;
    bottom: calc(100% + 0.8em);
    left: 50%;
    display: block;
    width: 2em;
    height: calc(var(--label-y) - var(--ring-y) - 0.8em);
    overflow: visible;
    fill: none;
    stroke: var(--t-annotation, var(--pure-black));
    stroke-linecap: round;
    translate: -50% 0;
    pointer-events: none;
  }

  .a10 .a10__stem path {
    vector-effect: non-scaling-stroke;
  }

  .a10 .a10__stem-base {
    stroke-width: 1.4;
  }

  .a10 .a10__stem-press {
    stroke-width: 2.4;
    stroke-dasharray: 0 6 38 22 18 16;
  }

  .a10 .a10__label--left .a10__stem-press {
    stroke-dasharray: 0 14 26 12 36 12;
  }

  .a10 .a10__label--right {
    --ring-y: calc(0.2222 * var(--hw));
    --label-y: calc(100svh - var(--space-48));

    top: var(--label-y);
    left: 83.2%;
  }

  .a10 .a10__label--left {
    --ring-y: calc(0.2697 * var(--hw));
    --label-y: calc(100svh - var(--space-32));

    top: var(--label-y);
    left: 64.9%;
  }

  /*
   * Hero, shared by every version; only the colours differ.
   * --h-size: headline size · --hands-w / --hands-left: the hands · --hands-top: where they hang from.
   */
  @media (min-width: 1101px) {
    /*
     * The hero stops growing at the site width: sizes are in --u (1vw, but never more than 1% of the site
     * width), and past it the hero is a centred frame lined up with the header.
     */
    .a10 .a10__hero {
      --u: min(1vw, calc(var(--layout-site-width) / 100));
      --h-size: calc(13.5 * var(--u));
      --hands-w: calc(80 * var(--u));
      --hands-left: calc(max(0px, (100% - var(--layout-site-width)) / 2) + 13 * var(--u));
      --h-top: calc(15 * var(--u));
      --hands-top: 0px;
    }

    /* The display face is set a size up. */
    .a10--jost .a10__hero {
      --h-size: calc(13.5 * var(--u));
    }

    .a10 .a10__hero {
      min-height: 72svh;
    }

    .a10 .a10__hero + :global(.pc) {
      position: relative;
      z-index: var(--z-raised);
      margin-top: calc(0px - var(--space-section));
    }
  }

  /*
   * Up to 1100px. The hands are --hw wide at --h-left; the title is --fs. The left fingertips land
   * ~0.667 × --hw down and each title line is 0.9 × --fs, so starting the title 2.4 lines
   * (2.16 × --fs) above that drops the final line between the fingers.
   */
  @media (max-width: 1100px) {
    /* Wide screens: the title is set by height, the hands fill the height and sit against the right edge. */
    .a10 .a10__hero {
      --hands-top: 0px;
      --hw: min(100svh, 80vw);
      --h-left: calc(100vw - var(--hw));
      --fs: 16.5svh;

      padding-top: calc(0.667 * var(--hw) - 2.16 * var(--fs));
    }

    .a10 .a10__hero h1 {
      font-size: var(--fs);
    }

    .a10 .a10__hands {
      left: var(--h-left);
      width: var(--hw);
    }
  }

  /* Tall screens: the title is set by width; the hands grow (up to 110vw, capped by height) and sit left. */
  @media (max-width: 1100px) and (orientation: portrait) {
    .a10 .a10__hero {
      --hw: min(110vw, 90svh);
      --h-left: calc(48vw - 0.5 * var(--hw));
      --fs: 17vw;
    }
  }

  @media (width <= 819px) {
    .a10 .a10__hero {
      --fs: 12vw;
    }
  }

  /* Mid-size composition is width-driven, so resizing past the viewport's aspect ratio cannot move it. */
  @media (501px <= width <= 819px) {
    .a10 .a10__hero {
      --hw: 110vw;
      --h-left: calc(48vw - 0.5 * var(--hw));
      --fs: clamp(12vw, calc(17.714vw - 22.286px), 14vw);
      padding-top: calc(0.4 * var(--hw) - 1.5 * var(--fs));
    }
  }

  @media (width <= 819px) {
    .a10 .a10__hero {
      min-height: 72svh;
    }

    .a10 .a10__label--right {
      --label-y: calc(100svh - var(--space-48) - var(--space-16));
    }

    .a10 .a10__label--left {
      --label-y: calc(100svh - var(--space-48));
    }

    .a10 .a10__hero + :global(.pc) {
      position: relative;
      z-index: var(--z-raised);
      margin-top: calc(0px - var(--space-section));
    }
  }

  /*
   * ═══ Letter-by-letter layering ════════════════════════════════════════════════
   * The headline characters are numbered 1–26 (HANDGJORDA 1–10, SMYCKEN 11–17, I 18,
   * the space 19, SILVER. 20–26). Letters are behind the fingers unless listed here.
   * The lists were tuned in the Supreme theme; the geometry is the same in every theme.
   */
  /* The letters are only a picture of the headline (the h1's aria-label carries the text), so clicks
     pass through them: the ones layered in front of the fingers would otherwise cover the ring names. */
  .a10--jost .a10__l {
    position: relative;
    z-index: var(--z-raised);
    pointer-events: none;
  }

  /*
   * The desktop composition holds down to 820px: headline, hands and spacing all in one width
   * unit (desktop's --u is 1vw below 1500px), so the letters meet the same fingers at every width.
   */
  @media (820px <= width <= 1100px) {
    .a10--jost .a10__hero {
      --u: 1vw;
      --hw: calc(80 * var(--u));
      --h-left: calc(13 * var(--u));
      --fs: calc(13.5 * var(--u));

      padding-top: calc(15 * var(--u));
    }
  }

  /* Wide desktop: a few letters dip behind the palms and fingers. */
  @media (width >= 1101px) {
    .a10--jost :is(.a10__l6, .a10__l7, .a10__l8, .a10__l9, .a10__l10, .a10__l11, .a10__l12, .a10__l13, .a10__l14, .a10__l15, .a10__l16, .a10__l18, .a10__l19, .a10__l20, .a10__l21, .a10__l22, .a10__l23) {
      z-index: calc(var(--z-base) - 1);
    }
  }

  /* Tablet landscape: the hands sit farther left, so the weave begins earlier in each word. */
  @media (820px <= width <= 1100px) {
    .a10--jost :is(.a10__l6, .a10__l7, .a10__l8, .a10__l9, .a10__l10, .a10__l11, .a10__l12, .a10__l13, .a10__l14, .a10__l15, .a10__l16, .a10__l18, .a10__l19, .a10__l20, .a10__l21, .a10__l22, .a10__l23) {
      z-index: calc(var(--z-base) - 1);
    }

    .a10 .a10__hero + :global(.pc) {
      position: relative;
      z-index: var(--z-raised);
      margin-top: calc(0px - var(--space-section));
    }

    .a10 .a10__hero {
      min-height: 72svh;
    }
  }

  /* One continuous weave throughout the width-based mid-size composition. */
  @media (501px <= width <= 819px) {
    .a10--jost :is(.a10__l5, .a10__l6, .a10__l7, .a10__l8, .a10__l9, .a10__l10, .a10__l11, .a10__l12, .a10__l13, .a10__l14, .a10__l15, .a10__l21, .a10__l23) {
      z-index: calc(var(--z-base) - 1);
    }
  }

  /* Compact phone landscape remains separate from the portrait-only phone composition below. */
  @media (width <= 500px) and (orientation: landscape) {
    .a10--jost :is(.a10__l9) {
      z-index: calc(var(--z-base) - 1);
    }
  }

  @media (width < 820px) {
    .a10--jost .a10__l21 {
      z-index: var(--z-raised);
    }
  }

  /*
   * Phones (550px and below): two halves. The hands fill the top half of the screen, cropped to it
   * at the wrists; the headline fills the bottom half on the plain page, in the theme's text colour
   * (Relief's white would vanish on paper). No ring callouts at this size.
   */
  @media (width <= 550px) {
    /* The headline's longest line (HANDGJORDA) is ~6.6 × its size wide: fit it between the gutters. */
    .a10 .a10__hero {
      --fs: calc((100vw - 2 * var(--layout-gutter)) / 6.6);

      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 50svh 1fr;
      min-height: 100svh;
      padding: 0;
    }

    .a10 .a10__hands {
      position: relative;
      grid-row: 1;
      top: 0;
      left: 0;
      width: 100%;
    }

    /* Cropped from the wrists, never the fingertips, whatever the screen's shape. */
    .a10 .a10__hands :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center bottom;
    }

    .a10.a10 .a10__hero h1 {
      grid-row: 2;
      align-self: center;
      padding-inline: var(--layout-gutter);
      color: var(--t-fg);
    }

    .a10 :is(.a10__line, .a10__label) {
      display: none;
    }

    .a10--jost .a10__l {
      z-index: var(--z-raised);
    }

    .a10 .a10__hero + :global(.pc) {
      margin-top: 0;
    }
  }

