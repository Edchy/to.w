---
// The site frame shared by every page: the theme article (the colour themes, switched from the
// footer and remembered per visitor), header, mobile menu and footer. Pages go in the slot.
// Extra attributes land on the article, so a page's scoped styles can reach it (and its theme).
import Footer from "./Footer.astro";
import Wordmark from "./Wordmark.astro";
import floralFrame from "../../assets/img/illustrations/floral-frame.webp";
import { CONTACT_EMAIL, CONTACT_EMAIL_HREF } from "../../config/site";

const { ...rest } = Astro.props;

// Colour themes: each is a class on the article (palettes in <style>). Relief is the default; the
// visitor's pick is remembered in localStorage and applied before the page paints. A theme can be
// built on others: Relief is Ren (all its rules apply) with white type over the homepage hero,
// Nature is Relief in moss greens, and Sand, Bark and Fjord are Nature in other earth colours.
// Each theme's swatch (in the footer and the phone menu) is the colour token named by `swatch`.
const themes: { id: string; label: string; swatch: string; base?: string[] }[] = [
  { id: "ren", label: "Ren", swatch: "--off-white" },
  { id: "relief", label: "Relief", swatch: "--pure-white", base: ["ren"] },
  { id: "nature", label: "Nature", swatch: "--nature-moss", base: ["ren", "relief"] },
  { id: "sand", label: "Sand", swatch: "--sand", base: ["ren", "relief", "nature"] },
  { id: "bark", label: "Bark", swatch: "--bark", base: ["ren", "relief", "nature"] },
  { id: "fjord", label: "Fjord", swatch: "--fjord", base: ["ren", "relief", "nature"] },
  { id: "supreme", label: "Supreme", swatch: "--supreme-red" },
  { id: "bla", label: "Blå", swatch: "--study-blue" },
];
const themeClasses = Object.fromEntries(
  themes.map((t) => [t.id, [...(t.base ?? []), t.id].map((id) => `a10--${id}`)]),
);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}/`;
const navLinks = [
  { href: "/smycken", label: "smycken" },
  { href: "/kurser", label: "kurser" },
  { href: "/om", label: "om" },
];
const current = (href: string) => (Astro.url.pathname.startsWith(withBase(href)) ? "page" : undefined);
---

<article class="a10 a10--jost a10--ren a10--relief" data-theme="relief" data-themes={JSON.stringify(themeClasses)} {...rest}>
  <script is:inline>
    // Apply the remembered theme before the page paints (no flash of the default).
    (() => {
      const article = document.currentScript.parentElement;
      const themes = JSON.parse(article.dataset.themes);
      let saved = null;
      try { saved = localStorage.getItem("tow-theme"); } catch {}
      if (saved && themes[saved]) {
        article.classList.remove(...themes[article.dataset.theme]);
        article.classList.add(...themes[saved]);
        article.dataset.theme = saved;
      }
    })();
  </script>
  <header class="a10__header">
    <a class="a10__wordmark" href={baseUrl}>
      <Wordmark class="a10__logo" />
    </a>
    <nav aria-label="Huvudnavigering">
      {navLinks.map(({ href, label }) => <a href={withBase(href)} aria-current={current(href)}>{label}</a>)}
    </nav>
    <button class="a10__burger" type="button" aria-label="Öppna meny" aria-expanded="false" aria-controls="a10-menu">
      <span class="a10__burger-bar"></span>
      <span class="a10__burger-bar"></span>
    </button>
  </header>

  <!--
    Phone menu: a full-screen panel in the theme's button colours, inside the hand-drawn floral frame.
    The pages, then the theme swatches and the contact links at the foot.
  -->
  <div class="a10__menu" id="a10-menu" role="dialog" aria-label="Meny" aria-modal="true" style={`--menu-frame: url("${floralFrame.src}")`}>
    <span class="a10__menu-frame" aria-hidden="true"></span>
    <ul class="a10__menu-list" role="list">
      {navLinks.map(({ href, label }) => (
        <li><a class="a10__menu-link" href={withBase(href)} aria-current={current(href)}>{label}</a></li>
      ))}
    </ul>
    <div class="a10__menu-foot">
      <div class="a10__menu-themes" role="group" aria-label="Färgtema">
        {themes.map((theme) => (
          <button class="a10__menu-swatch" type="button" data-theme={theme.id} aria-label={theme.label} title={theme.label} style={`--theme-swatch: var(${theme.swatch})`}></button>
        ))}
      </div>
      <div class="a10__menu-contact">
        <a href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a>
        <a href="https://instagram.com/tovewatte" target="_blank" rel="noopener noreferrer">instagram</a>
      </div>
    </div>
  </div>

  <slot />

  <Footer {themes} />
</article>

<script>
  // Mobile menu, ported from the live site's BaseLayout. While open, the page behind is
  // scroll-locked and inert; Escape or the button closes it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".a10__burger")) {
    const menu = document.getElementById(btn.getAttribute("aria-controls") ?? "");
    const article = btn.closest(".a10");
    if (!menu || !article) continue;

    // Everything in the panel except the header (it holds the close button) and the menu itself.
    const behind = [...article.children].filter((el) => el !== menu && !el.classList.contains("a10__header"));
    let lockedScrollY = 0;

    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Stäng meny" : "Öppna meny");
      for (const el of behind) el.toggleAttribute("inert", open);

      if (open) {
        lockedScrollY = window.scrollY;
        document.documentElement.classList.add("has-mobile-nav-open");
        Object.assign(document.body.style, { position: "fixed", top: `-${lockedScrollY}px`, left: "0", right: "0", width: "100%" });
        menu.querySelector("a")?.focus();
      } else {
        document.documentElement.classList.remove("has-mobile-nav-open");
        Object.assign(document.body.style, { position: "", top: "", left: "", right: "", width: "" });
        window.scrollTo(0, lockedScrollY);
        btn.focus();
      }
    };

    btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  // Theme switcher: swaps the theme's classes on the article and remembers the pick.
  for (const article of document.querySelectorAll<HTMLElement>(".a10[data-themes]")) {
    const themes: Record<string, string[]> = JSON.parse(article.dataset.themes ?? "{}");
    const buttons = [...article.querySelectorAll<HTMLButtonElement>("button[data-theme]")];
    const mark = () => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.theme === article.dataset.theme));
    };
    for (const b of buttons) {
      b.addEventListener("click", () => {
        const id = b.dataset.theme ?? "";
        if (!themes[id]) return;
        for (const classes of Object.values(themes)) article.classList.remove(...classes);
        article.classList.add(...themes[id]);
        article.dataset.theme = id;
        try { localStorage.setItem("tow-theme", id); } catch {}
        mark();
      });
    }
    mark();
  }
</script>

<style>
  /*
   * Theme variables. Blå's values are the defaults below; Ren and Supreme override them further down.
   * --t-page is the page (and hero) colour; each section can set its own --t-<section>-bg / -fg.
   */
  .a10 {
    --t-page: var(--study-blue);
    --t-fg: var(--study-paper-bright);
    --t-accent: var(--study-pink);
    --t-display: var(--font-display);
    --t-body: var(--font-display);
    --t-btn-bg: var(--study-paper-bright);
    --t-btn-fg: var(--study-ink);

    position: relative;
    min-height: 100svh;
    overflow-x: clip;
    color: var(--t-fg);
    background-color: var(--t-page);
    font-family: var(--t-body);
    /* Light type on dark blue renders heavy on macOS by default; grayscale smoothing thins it. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Inherited by every underlined link in the page's sections. */
    text-underline-offset: var(--underline-offset);
  }

  .a10__header {
    position: absolute;
    z-index: var(--z-raised);
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding: var(--space-6) var(--layout-gutter);
  }

  .a10__header a {
    color: inherit;
    text-decoration: none;
  }

  /* Shared header wordmark. */
  .a10__wordmark {
    display: inline-block;
    font-size: var(--font-size-xl);
    line-height: 0;
  }

  /* Sized from the wordmark link's (fluid) font size: about 14px tall on phones, 17px on desktop. */
  .a10__logo {
    display: block;
    width: auto;
    height: 0.65em;
  }

  .a10__header nav {
    display: flex;
    gap: var(--space-6);
  }

  /* The page you're on gets a hand-drawn oval in the nav and the menu. */
  .a10 [aria-current="page"] {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }

  .a10 [aria-current="page"]::before,
  .a10 [aria-current="page"]::after {
    position: absolute;
    content: "";
    pointer-events: none;
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
  }

  .a10 [aria-current="page"]::before {
    inset: calc(-1 * var(--space-1)) calc(-1 * var(--space-2));
    rotate: -3deg;
  }

  .a10 [aria-current="page"]::after {
    inset: calc(-1 * var(--space-1)) calc(-1 * var(--space-1)) calc(-1 * var(--space-2)) calc(-1 * var(--space-2));
    opacity: var(--opacity-muted);
    rotate: 2deg;
  }

  /*
   * Mobile menu, ported from the live site: at 700px and below the text links give way to a
   * two-bar button that opens a full-screen panel in the version's own colours. While it is open
   * the header is pinned above the panel so the logo and the close button stay put.
   */
  .a10__burger {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }

  .a10__burger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    transform-origin: center;
    transition: transform var(--transition-normal);
  }

  .a10__burger[aria-expanded="true"] .a10__burger-bar:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }

  .a10__burger[aria-expanded="true"] .a10__burger-bar:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Outranks the header layering further down (the header drops its own layer). */
  .a10 .a10__header:has(.a10__burger[aria-expanded="true"]) {
    position: fixed;
    z-index: calc(var(--z-modal) + 1);
    color: var(--t-btn-fg);
  }

  /* Over the open menu the logo and close button keep the panel's type colour, whatever a theme's
     hover does (a tap leaves the button "hovered" on phones). */
  .a10 .a10__header:has(.a10__burger[aria-expanded="true"]) :is(a, button) {
    color: inherit;
  }

  /* On the modal layer: page overlays (the product cards' hover names use --z-overlay) stay beneath. */
  .a10__menu {
    position: fixed;
    z-index: var(--z-modal);
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    overflow: hidden auto;
    padding: calc(var(--nav-height) + var(--space-4)) calc(var(--layout-gutter) + var(--space-4)) var(--space-12);
    color: var(--t-btn-fg);
    background-color: var(--t-btn-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-normal);
  }

  .a10__menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html.has-mobile-nav-open),
  :global(html.has-mobile-nav-open body) {
    overflow: hidden;
  }

  /*
   * The hand-drawn floral frame around the panel, drawn in the panel's type colour: the drawing is
   * a mask over a block of currentColor, so it follows every theme. Its pencil rectangle spans
   * roughly 11–88% across and 9–95% down, so the box reaches past the panel's sides (117% wide)
   * to seat the lines close to the screen edges; the outermost leaves are clipped.
   */
  .a10__menu-frame {
    position: absolute;
    top: calc(var(--nav-height) - var(--space-8));
    right: -9%;
    bottom: 0;
    left: -8%;
    background-color: currentColor;
    mask: var(--menu-frame) center / 100% 100% no-repeat;
    pointer-events: none;
  }

  .a10__menu-list {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: clamp(var(--space-2), 2vh, var(--space-6));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a10__menu-link {
    display: block;
    font-family: var(--t-display);
    font-size: var(--font-size-mega);
    line-height: var(--font-leading-display);
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  /* Focus (the menu opens with it on the first link) underlines like hover instead of boxing. */
  .a10__menu-link:is(:hover, :focus-visible) {
    outline: none;
    text-decoration: underline;
  }

  /* The foot of the menu: theme swatches, then email and Instagram. */
  .a10__menu-foot {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  /* Two even rows of four, so no swatch is left on a row of its own. */
  .a10__menu-themes {
    display: grid;
    grid-template-columns: repeat(4, var(--size-control));
    margin-inline: calc(0px - var(--space-2));
  }

  /* A full tap target around a large dot in the theme's own colour. */
  .a10__menu-swatch {
    position: relative;
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .a10__menu-swatch::before {
    position: absolute;
    inset: var(--space-2);
    content: "";
    background: var(--theme-swatch);
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
  }

  .a10__menu-swatch[aria-pressed="true"]::before {
    outline: var(--border-width) solid currentColor;
    outline-offset: var(--space-1);
  }

  .a10__menu-swatch:focus-visible {
    outline: var(--border-width-thick) solid currentColor;
    outline-offset: 0;
  }

  .a10__menu-contact {
    display: grid;
    font-size: var(--font-size-xl);
  }

  .a10__menu-contact a {
    display: flex;
    align-items: center;
    min-height: var(--size-control);
    color: inherit;
    text-decoration: none;
  }

  .a10__menu-contact a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  @media (max-width: 1100px) {
    .a10__header nav {
      padding-right: 0;
    }
  }

  @media (max-width: 700px) {
    .a10__header {
      padding-block: var(--space-4);
    }

    .a10__wordmark {
      display: flex;
      align-items: center;
      min-width: var(--size-control);
      min-height: var(--size-control);
    }

    .a10__header nav {
      display: none;
    }

    .a10__burger {
      display: flex;
    }

    .a10__header nav {
      gap: var(--space-4);
    }
  }

  /* ═══ Colour themes ════════════════════════════════════════════════════════════
   * Blå is the base palette (the .a10 defaults at the top of <style>); Ren and Supreme override
   * it. The palette colours are primitives in tokens.css.
   */

  /* Ren — warm paper page and sections throughout, black type, lines and buttons. */
  .a10--ren {
    --t-page: var(--off-white);
    --t-fg: var(--pure-black);
    --t-accent: var(--pure-black);
    --t-btn-bg: var(--pure-black);
    --t-btn-fg: var(--pure-white);
    --t-courses-bg: var(--off-white);
    --t-courses-fg: var(--pure-black);
    --t-insta-bg: var(--off-white);
    --t-insta-fg: var(--pure-black);
    --t-footer-bg: var(--off-white);
    --t-footer-fg: var(--pure-black);
  }

  /* Ren's accent is black like its type, so hovers underline, fade or invert instead of recolouring. */
  .a10--ren .a10__menu-link:hover {
    text-decoration: underline;
  }

  /*
   * Relief — Ren (it carries Ren's class too) on a slightly darker paper, with the homepage hero's
   * headline and ring annotations in white, pressed into the paper. The header (wordmark, nav and
   * menu button) is white too. --t-relief-fg is that light type and --t-relief-press the colour
   * it darkens to on hover, so a theme built on Relief can recolour both.
   */
  .a10--relief {
    --t-relief-fg: var(--pure-white);
    --t-relief-press: var(--study-ink);
    --t-hero-fg: var(--t-relief-fg);
    --t-page: var(--relief-paper);
    --t-courses-bg: var(--relief-paper);
    --t-insta-bg: var(--relief-paper);
    --t-footer-bg: var(--relief-paper);
    --t-products-hover: var(--t-relief-fg);
    --t-insta-heading: var(--t-relief-fg);
    --t-footer-logo: var(--t-relief-fg);
  }

  .a10--relief .a10__header {
    color: var(--t-relief-fg);
  }

  /* A slight shadow lifts the white off the paper; drop-shadow so the SVG wordmark gets it too. */
  .a10--relief .a10__header :is(a, button) {
    filter: drop-shadow(var(--shadow-text));
    transition: filter var(--transition-normal), color var(--transition-normal);
  }

  /* On hover the shadow fades and the white darkens to ink, as if pressed flat (keyboard focus too;
     not on touch screens, where a tap would leave it stuck). */
  .a10--relief .a10__header :is(a, button):focus-visible {
    color: var(--t-relief-press);
    filter: none;
  }

  @media (hover: hover) {
    .a10--relief .a10__header :is(a, button):hover {
      color: var(--t-relief-press);
      filter: none;
    }
  }

  /*
   * Nature — Relief (it carries Ren's and Relief's classes too) on moss: the light type is a pale
   * moss, and sentences, lines and buttons a deep one, instead of white and black. The three shades
   * are --t-nature-bg / -light / -dark, so the earth themes below only swap those. --t-nature-text
   * is the colour of all other type: Nature's own is the pale moss; the earth themes use their dark.
   */
  .a10--nature {
    --t-nature-bg: var(--nature-moss);
    --t-nature-light: var(--nature-moss-light);
    --t-nature-dark: var(--nature-moss-dark);
    --t-nature-text: var(--t-nature-light);
    --t-relief-fg: var(--t-nature-light);
    --t-relief-press: var(--t-nature-dark);
    --t-page: var(--t-nature-bg);
    --t-fg: var(--t-nature-text);
    --t-accent: var(--t-nature-text);
    --t-btn-bg: var(--t-nature-dark);
    --t-btn-fg: var(--t-nature-light);
    --t-courses-bg: var(--t-nature-bg);
    --t-courses-fg: var(--t-nature-text);
    --t-insta-bg: var(--t-nature-bg);
    --t-insta-fg: var(--t-nature-text);
    --t-footer-bg: var(--t-nature-bg);
    --t-footer-fg: var(--t-nature-text);
    --t-annotation: var(--t-nature-text);
  }

  /* Sand — beige, with near-white type and a deep brown. */
  .a10--sand {
    --t-nature-bg: var(--sand);
    --t-nature-light: var(--sand-light);
    --t-nature-dark: var(--sand-dark);
    --t-nature-text: var(--t-nature-dark);
  }

  /* Bark — warm brown, with pale clay type and a near-black brown. */
  .a10--bark {
    --t-nature-bg: var(--bark);
    --t-nature-light: var(--bark-light);
    --t-nature-dark: var(--bark-dark);
    --t-nature-text: var(--t-nature-dark);
  }

  /* Fjord — grey-blue water, with pale blue type and a deep navy. */
  .a10--fjord {
    --t-nature-bg: var(--fjord);
    --t-nature-light: var(--fjord-light);
    --t-nature-dark: var(--fjord-dark);
    --t-nature-text: var(--t-nature-dark);
  }

  /*
   * Supreme — box-logo red page, white type in a heavy slanted display face for titles and
   * interface, EB Garamond for sentences;
   * white courses with red type, black Instagram and footer.
   */
  .a10--supreme {
    --t-page: var(--supreme-red);
    --t-fg: var(--pure-white);
    --t-accent: var(--pure-white);
    --t-btn-bg: var(--pure-white);
    --t-btn-fg: var(--supreme-red);
    --t-courses-bg: var(--pure-white);
    --t-courses-fg: var(--supreme-red);
    --t-insta-bg: var(--pure-black);
    --t-insta-fg: var(--pure-white);
    --t-footer-bg: var(--pure-black);
    --t-footer-fg: var(--pure-white);
  }

  /* Supreme's accent is white like its type, so menu links hover to black instead. */
  .a10--supreme .a10__menu-link:hover {
    color: var(--pure-black);
  }

  /* Every heading in heavy italic; the doubled class outranks the sections' own heading rules. */
  .a10--jost .a10__menu-link,
  .a10.a10--jost :global(:is(h1, h2, h3)) {
    font-weight: var(--font-weight-bold);
  }

  /*
   * The logo can go behind the homepage's hands while the nav stays in front: the header drops its
   * own layer so its parts can split.
   */
  .a10--jost .a10__header {
    z-index: auto;
  }

  .a10--jost .a10__header :is(nav, .a10__burger) {
    position: relative;
    z-index: var(--z-raised);
  }
</style>
