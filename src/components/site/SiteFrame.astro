---
// The site frame shared by every page: the theme article (four colour themes, switched from the
// footer and remembered per visitor), header, mobile menu and footer. Pages go in the slot.
// Extra attributes land on the article, so a page's scoped styles can reach it (and its theme).
import Footer from "./Footer.astro";
import Wordmark from "./Wordmark.astro";

const { ...rest } = Astro.props;

// Colour themes: each is a class on the article (palettes in <style>). Ren is the default; the
// visitor's pick is remembered in localStorage and applied before the page paints. A theme can be
// built on another: Relief is Ren (all its rules apply) with white type over the homepage hero.
const themes = [
  { id: "ren", label: "Ren" },
  { id: "relief", label: "Relief", base: "ren" },
  { id: "supreme", label: "Supreme" },
  { id: "bla", label: "Blå" },
];
const themeClasses = Object.fromEntries(
  themes.map((t) => [t.id, ["base" in t ? `a10--${t.base}` : "", `a10--${t.id}`].filter(Boolean)]),
);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}/`;
const navLinks = [
  { href: "/smycken", label: "smycken" },
  { href: "/kurser", label: "kurser" },
  { href: "/om", label: "om" },
];
const current = (href: string) => (Astro.url.pathname.startsWith(withBase(href)) ? "page" : undefined);
---

<article class="a10 a10--jost a10--ren" data-theme="ren" data-themes={JSON.stringify(themeClasses)} {...rest}>
  <script is:inline>
    // Apply the remembered theme before the page paints (no flash of the default).
    (() => {
      const article = document.currentScript.parentElement;
      const themes = JSON.parse(article.dataset.themes);
      let saved = null;
      try { saved = localStorage.getItem("tow-theme"); } catch {}
      if (saved && themes[saved]) {
        article.classList.remove("a10--ren");
        article.classList.add(...themes[saved]);
        article.dataset.theme = saved;
      }
    })();
  </script>
  <header class="a10__header">
    <a class="a10__wordmark" href={baseUrl}>
      <Wordmark class="a10__logo" />
    </a>
    <nav aria-label="Huvudnavigering">
      {navLinks.map(({ href, label }) => <a href={withBase(href)} aria-current={current(href)}>{label}</a>)}
    </nav>
    <button class="a10__burger" type="button" aria-label="Öppna meny" aria-expanded="false" aria-controls="a10-menu">
      <span class="a10__burger-bar"></span>
      <span class="a10__burger-bar"></span>
    </button>
  </header>

  <!-- Mobile menu, as on the live site: a full-screen panel in the theme's colours. -->
  <div class="a10__menu" id="a10-menu" role="dialog" aria-label="Meny" aria-modal="true">
    <ul class="a10__menu-list" role="list">
      {navLinks.map(({ href, label }) => (
        <li><a class="a10__menu-link" href={withBase(href)} aria-current={current(href)}>{label}</a></li>
      ))}
    </ul>
    <a class="a10__menu-social" href="https://instagram.com/tovewatte" target="_blank" rel="noopener noreferrer">instagram</a>
  </div>

  <slot />

  <Footer {themes} />
</article>

<script>
  // Mobile menu, ported from the live site's BaseLayout. While open, the page behind is
  // scroll-locked and inert; Escape or the button closes it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".a10__burger")) {
    const menu = document.getElementById(btn.getAttribute("aria-controls") ?? "");
    const article = btn.closest(".a10");
    if (!menu || !article) continue;

    // Everything in the panel except the header (it holds the close button) and the menu itself.
    const behind = [...article.children].filter((el) => el !== menu && !el.classList.contains("a10__header"));
    let lockedScrollY = 0;

    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Stäng meny" : "Öppna meny");
      for (const el of behind) el.toggleAttribute("inert", open);

      if (open) {
        lockedScrollY = window.scrollY;
        document.documentElement.classList.add("has-mobile-nav-open");
        Object.assign(document.body.style, { position: "fixed", top: `-${lockedScrollY}px`, left: "0", right: "0", width: "100%" });
        menu.querySelector("a")?.focus();
      } else {
        document.documentElement.classList.remove("has-mobile-nav-open");
        Object.assign(document.body.style, { position: "", top: "", left: "", right: "", width: "" });
        window.scrollTo(0, lockedScrollY);
        btn.focus();
      }
    };

    btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  // Theme switcher: swaps the theme's classes on the article and remembers the pick.
  for (const article of document.querySelectorAll<HTMLElement>(".a10[data-themes]")) {
    const themes: Record<string, string[]> = JSON.parse(article.dataset.themes ?? "{}");
    const buttons = [...article.querySelectorAll<HTMLButtonElement>("button[data-theme]")];
    const mark = () => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.theme === article.dataset.theme));
    };
    for (const b of buttons) {
      b.addEventListener("click", () => {
        const id = b.dataset.theme ?? "";
        if (!themes[id]) return;
        for (const classes of Object.values(themes)) article.classList.remove(...classes);
        article.classList.add(...themes[id]);
        article.dataset.theme = id;
        try { localStorage.setItem("tow-theme", id); } catch {}
        mark();
      });
    }
    mark();
  }
</script>

<style>
  /*
   * Theme variables. Blå's values are the defaults below; Ren and Supreme override them further down.
   * --t-page is the page (and hero) colour; each section can set its own --t-<section>-bg / -fg.
   */
  .a10 {
    --t-page: var(--study-blue);
    --t-fg: var(--study-paper-bright);
    --t-accent: var(--study-pink);
    --t-display: var(--font-display);
    --t-body: var(--font-display);
    --t-btn-bg: var(--study-paper-bright);
    --t-btn-fg: var(--study-ink);

    position: relative;
    min-height: 100svh;
    overflow-x: clip;
    color: var(--t-fg);
    background-color: var(--t-page);
    font-family: var(--t-body);
    /* Light type on dark blue renders heavy on macOS by default; grayscale smoothing thins it. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Inherited by every underlined link in the page's sections. */
    text-underline-offset: var(--underline-offset);
  }

  .a10__header {
    position: absolute;
    z-index: var(--z-raised);
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding: var(--space-6) var(--layout-gutter);
  }

  .a10__header a {
    color: inherit;
    text-decoration: none;
  }

  /* Shared header wordmark. */
  .a10__wordmark {
    display: inline-block;
    font-size: var(--font-size-xl);
    line-height: 0;
  }

  /* Sized from the wordmark link's (fluid) font size: about 14px tall on phones, 17px on desktop. */
  .a10__logo {
    display: block;
    width: auto;
    height: 0.65em;
  }

  .a10__header nav {
    display: flex;
    gap: var(--space-6);
    padding-right: var(--space-32);
  }

  /* The page you're on is underlined in the nav and the menu. */
  .a10 [aria-current="page"] {
    text-decoration: underline;
  }

  /*
   * Mobile menu, ported from the live site: at 700px and below the text links give way to a
   * two-bar button that opens a full-screen panel in the version's own colours. While it is open
   * the header is pinned above the panel so the logo and the close button stay put.
   */
  .a10__burger {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }

  .a10__burger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    transform-origin: center;
    transition: transform var(--transition-normal);
  }

  .a10__burger[aria-expanded="true"] .a10__burger-bar:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }

  .a10__burger[aria-expanded="true"] .a10__burger-bar:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Outranks the header layering further down (the header drops its own layer). */
  .a10 .a10__header:has(.a10__burger[aria-expanded="true"]) {
    position: fixed;
    z-index: var(--z-modal);
  }

  .a10__menu {
    position: fixed;
    z-index: var(--z-overlay);
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    overflow-y: auto;
    padding: calc(var(--nav-height) + var(--space-12)) var(--layout-gutter) var(--space-12);
    color: var(--t-fg);
    background-color: var(--t-page);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-normal);
  }

  .a10__menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html.has-mobile-nav-open),
  :global(html.has-mobile-nav-open body) {
    overflow: hidden;
  }

  .a10__menu-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: clamp(var(--space-2), 2vh, var(--space-6));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .a10__menu-link {
    display: block;
    font-family: var(--t-display);
    font-size: var(--font-size-mega);
    line-height: var(--font-leading-display);
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .a10__menu-link:hover {
    color: var(--t-accent);
  }

  .a10__menu-social {
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-rule);
    font-size: var(--font-size-lg);
    letter-spacing: var(--font-tracking-wide);
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .a10__header nav {
      padding-right: 0;
    }
  }

  @media (max-width: 700px) {
    .a10__header {
      padding-block: var(--space-4);
    }

    .a10__header nav {
      display: none;
    }

    .a10__burger {
      display: flex;
    }

    .a10__header nav {
      gap: var(--space-4);
    }
  }

  /* ═══ Colour themes ════════════════════════════════════════════════════════════
   * Blå is the base palette (the .a10 defaults at the top of <style>); Ren and Supreme override
   * it. The palette colours are primitives in tokens.css.
   */

  /* Ren — warm paper page and sections throughout, black type, lines and buttons. */
  .a10--ren {
    --t-page: var(--off-white);
    --t-fg: var(--pure-black);
    --t-accent: var(--pure-black);
    --t-btn-bg: var(--pure-black);
    --t-btn-fg: var(--pure-white);
    --t-courses-bg: var(--off-white);
    --t-courses-fg: var(--pure-black);
    --t-insta-bg: var(--off-white);
    --t-insta-fg: var(--pure-black);
    --t-footer-bg: var(--off-white);
    --t-footer-fg: var(--pure-black);
  }

  /* Ren's accent is black like its type, so hovers underline, fade or invert instead of recolouring. */
  .a10--ren .a10__menu-link:hover {
    text-decoration: underline;
  }

  /*
   * Relief — Ren (it carries Ren's class too), with the homepage hero's headline and ring
   * annotations in white, pressed into the paper. The header keeps Ren's black.
   */
  .a10--relief {
    --t-hero-fg: var(--pure-white);
  }

  /*
   * Supreme — box-logo red page, white type in heavy slanted Jost (a Futura revival, self-hosted
   * so the letters sit the same everywhere) for titles and interface, EB Garamond for sentences;
   * white courses with red type, black Instagram and footer.
   */
  .a10--supreme {
    --t-page: var(--supreme-red);
    --t-fg: var(--pure-white);
    --t-accent: var(--pure-white);
    --t-btn-bg: var(--pure-white);
    --t-btn-fg: var(--supreme-red);
    --t-courses-bg: var(--pure-white);
    --t-courses-fg: var(--supreme-red);
    --t-insta-bg: var(--pure-black);
    --t-insta-fg: var(--pure-white);
    --t-footer-bg: var(--pure-black);
    --t-footer-fg: var(--pure-white);
  }

  /* Supreme's accent is white like its type, so menu links hover to black instead. */
  .a10--supreme .a10__menu-link:hover {
    color: var(--pure-black);
  }

  /* Every heading in heavy italic; the doubled class outranks the sections' own heading rules. */
  .a10--jost .a10__menu-link,
  .a10.a10--jost :global(:is(h1, h2, h3)) {
    font-weight: var(--font-weight-bold);
    font-style: italic;
  }

  /*
   * The logo can go behind the homepage's hands while the nav stays in front: the header drops its
   * own layer so its parts can split.
   */
  .a10--jost .a10__header {
    z-index: auto;
  }

  .a10--jost .a10__header :is(nav, .a10__burger) {
    position: relative;
    z-index: var(--z-raised);
  }
</style>
