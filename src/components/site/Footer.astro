---
// The footer: the TO·W wordmark, the site links, contact, a small credit line and the theme
// swatches (folded behind a "tema" button), with the cheetah from the old logo standing on the
// wordmark as a decoration.
import { Image } from "astro:assets";
import Wordmark from "./Wordmark.astro";
import cheetah from "../../assets/img/illustrations/cheetah.webp";

type Props = {
  themes: { id: string; label: string }[];
};

const { themes } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}/`;
---

<footer class="f10">
  <a class="f10__logo" href={baseUrl}>
    <Image class="f10__cheetah" src={cheetah} alt="" aria-hidden="true" widths={[240, 480]} sizes="10rem" loading="lazy" />
    <Wordmark label="To.W – till startsidan" />
  </a>

  <nav class="f10__nav" aria-label="Sidfot">
    <a href={withBase("/smycken")}>smycken</a>
    <a href={withBase("/kurser")}>kurser</a>
    <a href={withBase("/om")}>om</a>
  </nav>

  <div class="f10__contact">
    <a href="mailto:tove.watte@gmail.com">tove.watte@gmail.com</a>
    <a href="https://instagram.com/tovewatte">@tovewatte</a>
  </div>

  <p class="f10__small">Tove Wätte · © {new Date().getFullYear()}</p>

  <div class="f10__picker">
    <button class="f10__picker-toggle" type="button" aria-expanded="false" aria-controls="f10-themes">tema</button>
    <div class="f10__themes" id="f10-themes" role="group" aria-label="Färgtema" hidden>
      {themes.map((theme) => (
        <button class={`f10__theme f10__theme--${theme.id}`} type="button" data-theme={theme.id} aria-label={theme.label} title={theme.label}></button>
      ))}
    </div>
  </div>
</footer>

<script>
  // "tema" shows and hides the swatches; picking one is handled by the site frame.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>(".f10__picker-toggle")) {
    const swatches = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      if (swatches) swatches.hidden = !open;
    });
  }
</script>

<style>
  .f10 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-8) var(--space-16);
    align-items: start;
    margin-inline: var(--layout-edge);
    padding-block: var(--space-32) var(--space-24);
    color: var(--t-footer-fg, inherit);
    background: var(--t-footer-bg, transparent);
    /* Full-bleed background while the content keeps its margins. */
    box-shadow: 0 0 0 100vmax var(--t-footer-bg, transparent);
    clip-path: inset(0 -100vmax);
    border-top: var(--border-width) solid var(--color-rule);
  }

  .f10 a {
    color: inherit;
    text-decoration: none;
  }

  .f10 a:hover,
  .f10 a:focus-visible {
    text-decoration: underline;
  }

  /* Sized from the heading scale, like the header's wordmark is from its link. */
  .f10__logo {
    position: relative;
    justify-self: start;
    font-size: var(--font-size-display);
    line-height: 0;
  }

  .f10__logo svg {
    display: block;
    color: var(--t-footer-logo, inherit);
    width: auto;
    height: 0.65em;
  }

  /* The cheetah stands on the wordmark's letters, as wide as the word. The drawing has transparent
     margins (2.2% on the left, 8.3% below its paws), so it is shifted by those. */
  .f10__logo :global(img.f10__cheetah) {
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    height: auto;
    translate: -2.2% 8.3%;
    pointer-events: none;
  }

  .f10__nav,
  .f10__contact {
    display: grid;
    gap: var(--space-1);
  }

  .f10__small {
    grid-column: 1;
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
  }

  /* The button sits at the row's end; the swatches open to its left, out of the grid's flow so the
     columns above don't shift when they appear. */
  .f10__picker {
    position: relative;
    grid-column: 3;
    justify-self: end;
  }

  /* Set like the credit line it shares the row with. */
  .f10__picker-toggle {
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
    cursor: pointer;
  }

  .f10__picker-toggle:is(:hover, :focus-visible),
  .f10__picker-toggle[aria-expanded="true"] {
    text-decoration: underline;
  }

  .f10__themes {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--space-4));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    translate: 0 -50%;
  }

  .f10__themes[hidden] {
    display: none;
  }

  .f10__theme {
    flex: 0 0 var(--space-4);
    width: var(--space-4);
    height: var(--space-4);
    padding: 0;
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
    appearance: none;
    cursor: pointer;
  }

  .f10__theme[aria-pressed="true"] {
    outline: var(--border-width) solid currentColor;
    outline-offset: var(--space-1);
  }

  .f10__theme--ren {
    --theme-swatch: var(--off-white);
    background: var(--theme-swatch);
  }

  /* Relief: white on the paper, like the type it stands for. */
  .f10__theme--relief {
    --theme-swatch: var(--pure-white);
    background: var(--theme-swatch);
  }

  .f10__theme--nature {
    --theme-swatch: var(--nature-moss);
    background: var(--theme-swatch);
  }

  .f10__theme--sand {
    --theme-swatch: var(--sand);
    background: var(--theme-swatch);
  }

  .f10__theme--bark {
    --theme-swatch: var(--bark);
    background: var(--theme-swatch);
  }

  .f10__theme--fjord {
    --theme-swatch: var(--fjord);
    background: var(--theme-swatch);
  }

  .f10__theme--supreme {
    --theme-swatch: var(--supreme-red);
    background: var(--theme-swatch);
  }

  .f10__theme--bla {
    --theme-swatch: var(--study-blue);
    background: var(--theme-swatch);
  }

  @media (max-width: 700px) {
    .f10 {
      grid-template-columns: 1fr 1fr;
    }

    .f10__logo {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      min-width: var(--size-control);
      min-height: var(--size-control);
    }

    .f10__nav,
    .f10__contact {
      gap: 0;
    }

    .f10__nav a,
    .f10__contact a {
      display: flex;
      align-items: center;
      min-height: var(--size-control);
    }

    /* Phones: the button first, the swatches on their own row beneath, each a full tap target. */
    .f10__picker {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .f10__picker-toggle {
      min-height: var(--size-control);
    }

    .f10__themes {
      position: static;
      flex-wrap: wrap;
      gap: 0;
      translate: none;
    }

    .f10__theme {
      position: relative;
      flex-basis: var(--size-control);
      width: var(--size-control);
      height: var(--size-control);
      background: transparent;
      border: 0;
    }

    .f10__theme::before {
      position: absolute;
      top: 50%;
      left: 50%;
      width: var(--space-4);
      height: var(--space-4);
      content: "";
      background: var(--theme-swatch);
      border: var(--border-width) solid currentColor;
      border-radius: var(--radius-full);
      translate: -50% -50%;
    }

    .f10__theme[aria-pressed="true"] {
      outline: none;
    }

    .f10__theme[aria-pressed="true"]::before {
      outline: var(--border-width) solid currentColor;
      outline-offset: var(--space-1);
    }

    .f10__theme:focus-visible {
      outline: var(--border-width-thick) solid currentColor;
      outline-offset: 0;
    }
  }
</style>
