---
// The footer: the TO·W wordmark, the site links, contact, a small credit line and the theme
// swatches (folded behind a "tema" button), with the cheetah from the old logo standing on the
// wordmark as a decoration.
import { Image } from "astro:assets";
import Wordmark from "./Wordmark.astro";
import cheetah from "../../assets/img/illustrations/cheetah.webp";

type Props = {
  themes: { id: string; label: string; swatch: string }[];
};

const { themes } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}/`;
---

<footer class="f10">
  <a class="f10__logo" href={baseUrl} aria-label="To.W – till startsidan">
    <Image class="f10__cheetah" src={cheetah} alt="" aria-hidden="true" widths={[240, 480, 960]} sizes="(max-width: 700px) 80vw, 10rem" loading="lazy" />
    <Wordmark label="To.W – till startsidan" />
  </a>

  <nav class="f10__nav" aria-label="Sidfot">
    <a href={withBase("/smycken")}>smycken</a>
    <a href={withBase("/kurser")}>kurser</a>
    <a href={withBase("/om")}>om</a>
  </nav>

  <div class="f10__contact">
    <a href="mailto:tove.watte@gmail.com">tove.watte@gmail.com</a>
    <a href="https://instagram.com/tovewatte">@tovewatte</a>
  </div>

  <p class="f10__small">Tove Wätte · © {new Date().getFullYear()}</p>

  <div class="f10__picker">
    <button class="f10__picker-toggle" type="button" aria-expanded="false" aria-controls="f10-themes">tema</button>
    <div class="f10__themes" id="f10-themes" role="group" aria-label="Färgtema" hidden>
      {themes.map((theme) => (
        <button class="f10__theme" type="button" data-theme={theme.id} aria-label={theme.label} title={theme.label} style={`--theme-swatch: var(${theme.swatch})`}></button>
      ))}
    </div>
  </div>

  <a class="f10__top" href="#" aria-label="Till toppen">
    <Wordmark aria-hidden="true" />
  </a>
</footer>

<script>
  // The phone footer's wordmark glides back to the top (a plain jump for visitors who ask for less motion) and hands
  // focus to the header's wordmark, so keyboard users land at the top too.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".f10__top")) {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: smooth ? "smooth" : "auto" });
      document.querySelector<HTMLElement>(".a10__wordmark")?.focus({ preventScroll: true });
    });
  }

  // "tema" shows and hides the swatches; picking one is handled by the site frame.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>(".f10__picker-toggle")) {
    const swatches = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      if (swatches) swatches.hidden = !open;
    });
  }
</script>

<style>
  .f10 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--space-8) var(--space-16);
    align-items: start;
    margin-inline: var(--layout-edge);
    padding-block: var(--space-32) var(--space-24);
    color: var(--t-footer-fg, inherit);
    background: var(--t-footer-bg, transparent);
    /* Full-bleed background while the content keeps its margins. */
    box-shadow: 0 0 0 100vmax var(--t-footer-bg, transparent);
    clip-path: inset(0 -100vmax);
    border-top: var(--border-width) solid var(--color-rule);
  }

  .f10 a {
    color: inherit;
    text-decoration: none;
  }

  .f10 a:hover,
  .f10 a:focus-visible {
    text-decoration: underline;
  }

  /* Sized from the heading scale, like the header's wordmark is from its link. */
  .f10__logo {
    position: relative;
    justify-self: start;
    font-size: var(--font-size-display);
    line-height: 0;
  }

  .f10__logo svg {
    display: block;
    color: var(--t-footer-logo, inherit);
    width: auto;
    height: 0.65em;
  }

  /* The cheetah stands on the wordmark's letters, as wide as the word. The drawing has transparent
     margins (2.2% on the left, 8.3% below its paws), so it is shifted by those. */
  .f10__logo :global(img.f10__cheetah) {
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    height: auto;
    translate: -2.2% 8.3%;
    pointer-events: none;
  }

  .f10__nav,
  .f10__contact {
    display: grid;
    gap: var(--space-1);
  }

  .f10__small {
    grid-column: 1;
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
  }

  /* The button sits at the row's end; the swatches open to its left, out of the grid's flow so the
     columns above don't shift when they appear. */
  .f10__picker {
    position: relative;
    grid-column: 3;
    justify-self: end;
  }

  /* Set like the credit line it shares the row with. */
  .f10__picker-toggle {
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
    cursor: pointer;
  }

  .f10__picker-toggle:is(:hover, :focus-visible),
  .f10__picker-toggle[aria-expanded="true"] {
    text-decoration: underline;
  }

  .f10__themes {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--space-4));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    translate: 0 -50%;
  }

  .f10__themes[hidden] {
    display: none;
  }

  .f10__theme {
    flex: 0 0 var(--space-4);
    width: var(--space-4);
    height: var(--space-4);
    padding: 0;
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
    appearance: none;
    cursor: pointer;
  }

  .f10__theme[aria-pressed="true"] {
    outline: var(--border-width) solid currentColor;
    outline-offset: var(--space-1);
  }

  .f10__theme {
    background: var(--theme-swatch);
  }

  /* Only phones show the wordmark that leads back to the top. */
  .f10__top {
    display: none;
  }

  /*
   * Phones: nothing but the TO·W wordmark, centred; it glides back to the top. The pages, the theme
   * swatches and the contact links are in the menu.
   */
  @media (max-width: 700px) {
    .f10 {
      display: flex;
      justify-content: center;
      padding-block: var(--space-16) var(--space-12);
    }

    .f10 :is(.f10__logo, .f10__nav, .f10__contact, .f10__small, .f10__picker) {
      display: none;
    }

    /* Outranks `.f10 a`, so the wordmark takes the theme's footer-logo colour (white in Relief). */
    .f10 .f10__top {
      display: grid;
      place-items: center;
      min-width: var(--size-control);
      min-height: var(--size-control);
      font-size: var(--font-size-display);
      line-height: 0;
      color: var(--t-footer-logo, inherit);
    }

    .f10__top :global(svg) {
      width: auto;
      height: 0.65em;
    }
  }
</style>
