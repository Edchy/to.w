---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import wateringCan from "../../assets/img/studies/cobalt-watering-can-study-v1.png";
import { getProductSlug } from "../../config/site";

type Props = { items: CollectionEntry<"jewelry">[] };
const { items } = Astro.props;
const featured = items.slice(0, 6);
const fmt = new Intl.NumberFormat("sv-SE").format;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<article class="catalogue" data-direction-panel="catalogue" hidden>
  <header class="catalogue__header">
    <a class="catalogue__wordmark" href={baseUrl}>towtow</a>
    <p>Handgjorda smycken<br />Järna, Sverige</p>
    <nav aria-label="Huvudnavigering">
      <a href={withBase("/smycken")}>Smycken</a>
      <a href={withBase("/kurser")}>Kurser</a>
      <a href={withBase("/om")}>Om</a>
    </nav>
  </header>

  <main>
    <section class="catalogue__intro">
      <p class="catalogue__index">Index 01—06</p>
      <h1>Ringar som får<br />visa hur de blev till.</h1>
      <p class="catalogue__lede">Återvunnet silver, formade för hand av Tove Wätte. Varje exemplar får behålla små skillnader och spår av arbetet.</p>
    </section>

    <section class="catalogue__grid" aria-label="Utvalda smycken">
      {featured.map((entry, index) => (
        <a class="catalogue__item" href={withBase(`/smycken/${getProductSlug(entry.id)}`)}>
          <span class="catalogue__number">{String(index + 1).padStart(2, "0")}</span>
          <Image src={entry.data.images[0]} alt={entry.data.title} loading={index < 2 ? "eager" : "lazy"} />
          <div>
            <h2>{entry.data.title}</h2>
            <p>{fmt(entry.data.price)} kr</p>
          </div>
        </a>
      ))}
    </section>

    <section class="catalogue__note">
      <Image src={wateringCan} alt="" aria-hidden="true" />
      <p><span>En annan sorts kväll</span> Kom till verkstaden och forma din egen ring i vax. Jag gjuter den sedan i återvunnet silver.</p>
      <a href={withBase("/kurser")}>Till kurserna →</a>
    </section>
  </main>

  <footer class="catalogue__footer">
    <span>TO.W</span>
    <a href="mailto:tove.watte@gmail.com">Beställ och fråga via mejl</a>
    <span>© {new Date().getFullYear()}</span>
  </footer>
</article>

<style>
  .catalogue {
    min-height: 100vh;
    color: var(--study-ink);
    background: var(--study-paper-bright);
    font-family: var(--font-study-sans);
  }

  .catalogue a {
    color: inherit;
  }

  .catalogue__header,
  .catalogue__intro,
  .catalogue__grid,
  .catalogue__note,
  .catalogue__footer {
    width: min(100%, var(--layout-site-width));
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .catalogue__header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--grid-gutter);
    align-items: start;
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--study-ink);
  }

  .catalogue__wordmark {
    font-family: var(--font-study-isenheim);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
  }

  .catalogue__header p {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .catalogue__header nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-lg);
    padding-right: var(--space-32);
  }

  .catalogue__intro {
    display: grid;
    grid-template-columns: 0.35fr 1.3fr 0.6fr;
    gap: var(--grid-gutter);
    align-items: end;
    padding-block: var(--space-24) var(--space-32);
  }

  .catalogue__index,
  .catalogue__lede {
    margin: 0;
  }

  .catalogue__index {
    align-self: start;
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--font-tracking-wide);
  }

  .catalogue h1 {
    margin: 0;
    font-family: var(--font-study-serif);
    font-size: var(--study-type-catalogue-hero);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-leading-display);
    letter-spacing: var(--font-tracking-negative);
  }

  .catalogue__lede {
    max-width: 34ch;
    font-size: var(--font-size-base);
  }

  .catalogue__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-20) var(--space-lg);
    padding-bottom: var(--space-32);
  }

  .catalogue__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-sm) var(--space-md);
    text-decoration: none;
  }

  .catalogue__number {
    grid-row: 1 / span 2;
    writing-mode: vertical-rl;
    font-size: var(--font-size-xs);
    letter-spacing: var(--font-tracking-wider);
  }

  .catalogue__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter var(--transition-normal);
  }

  .catalogue__item > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: baseline;
  }

  .catalogue__item h2,
  .catalogue__item p {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
  }

  .catalogue__note {
    position: relative;
    display: grid;
    grid-template-columns: 0.6fr 1fr 0.5fr;
    gap: var(--grid-gutter);
    align-items: center;
    min-height: 75vh;
    padding-block: var(--space-24);
    color: var(--study-paper-bright);
    background: var(--study-cobalt);
  }

  .catalogue__note::before {
    content: "";
    position: absolute;
    z-index: -1;
    right: 0;
    left: 0;
    height: 100%;
    background: var(--study-cobalt);
  }

  .catalogue__note :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    transform: rotate(-5deg);
  }

  .catalogue__note p {
    margin: 0;
    font-family: var(--font-study-serif);
    font-size: var(--study-type-catalogue-note);
    line-height: var(--font-leading-note);
  }

  .catalogue__note p span {
    display: block;
    margin-bottom: var(--space-md);
    font-family: var(--font-study-sans);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--font-tracking-wider);
  }

  .catalogue__note > a {
    justify-self: end;
    color: var(--study-paper-bright);
  }

  .catalogue__footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-10);
    border-top: 1px solid var(--study-ink);
  }

  .catalogue__footer span:last-child {
    justify-self: end;
  }

  @media (hover: hover) {
    .catalogue__item:hover :global(img) {
      filter: grayscale(0);
    }
  }

  @media (max-width: 800px) {
    .catalogue__header {
      grid-template-columns: 1fr 1fr;
    }

    .catalogue__header > p {
      display: none;
    }

    .catalogue__header nav {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-sm);
      padding-right: var(--space-12);
    }

    .catalogue__intro {
      grid-template-columns: 1fr;
      padding-block: var(--space-16) var(--space-20);
    }

    .catalogue h1 {
      font-size: var(--study-type-catalogue-hero-mobile);
    }

    .catalogue__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--space-sm);
    }

    .catalogue__item {
      grid-template-columns: 1fr;
    }

    .catalogue__number {
      grid-row: auto;
      writing-mode: horizontal-tb;
    }

    .catalogue__item > div {
      display: grid;
      gap: var(--space-xs);
    }

    .catalogue__note {
      grid-template-columns: 1fr;
    }

    .catalogue__note :global(img) {
      width: min(70%, 20rem);
    }

    .catalogue__note > a {
      justify-self: start;
    }

    .catalogue__footer {
      grid-template-columns: 1fr auto;
    }

    .catalogue__footer a {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
