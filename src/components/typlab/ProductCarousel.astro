---
// The homepage product strip: each ring sits on the section colour in a sideways-scrolling row.
// With `grid`, the same cards are laid out in rows instead (the smycken page).
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { RING_TRANSITION_CLASS, getProductSlug, ringTransitionName } from "../../config/site";
import floralFrame from "../../assets/img/illustrations/floral-frame.webp";

type Props = { items: CollectionEntry<"jewelry">[]; grid?: boolean };

const { items, grid = false } = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const fmt = new Intl.NumberFormat("sv-SE").format;

// The strip shows the collection oldest-first (items arrive newest-first), starting with bark.
const products = items
  .map((entry) => ({
    title: entry.data.title,
    transitionName: ringTransitionName(getProductSlug(entry.id)),
    price: fmt(entry.data.price),
    href: `${baseUrl}smycken/${getProductSlug(entry.id)}/`,
    kind: entry.data.kind,
    image: entry.data.productImage ?? entry.data.images[0],
  }))
  .reverse();
---

<section class:list={["pc", grid && "pc--grid"]} aria-label="Smycken" data-carousel={grid ? undefined : ""}>
  <ul class="pc__track" data-carousel-track>
    {products.map((product, index) => (
      <li class="pc__card">
        <a href={product.href}>
          <span class="pc__frame">
            <span class="pc__stage"></span>
            <Image class="pc__drawn-frame" src={floralFrame} alt="" widths={[480, 960]} sizes="(max-width: 700px) 95vw, 29rem" loading="lazy" />
            <Image
              class="pc__ring"
              src={product.image}
              alt={`${product.title}, ${product.kind ?? "smycke"} i återvunnet silver`}
              widths={[320, 640]}
              sizes="(max-width: 700px) 50vw, 15rem"
              loading={index < 4 ? "eager" : "lazy"}
            />
          </span>
          <span class="pc__meta">
            <span class="pc__title" data-transition-name={product.transitionName} data-transition-class={RING_TRANSITION_CLASS}>{product.title}</span>
            <span class="pc__price">{product.price} kr</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  {!grid && <div class="pc__foot">
    <div class="pc__controls">
      <button type="button" data-carousel-prev aria-label="Föregående smycken">←</button>
      <button type="button" data-carousel-next aria-label="Fler smycken">→</button>
      <a href={`${baseUrl}smycken/`}>alla smycken →</a>
    </div>
  </div>}
</section>

<script is:inline>
  // A ring's name travels between its card and its product page heading. Only the card for the
  // page being opened (or returned from) gets the transition name; if every card had one, all the
  // other names would fly across the product page too (its "Fler smycken" strip has them).
  if (!window.ringTransitions) {
    window.ringTransitions = true;
    const name = (url) => {
      const path = url && new URL(url).pathname;
      const card = [...document.querySelectorAll(".pc__card a")].find((a) => new URL(a.href).pathname === path);
      const title = card?.querySelector("[data-transition-name]");
      if (!title) return;
      title.style.viewTransitionName = title.dataset.transitionName;
      title.style.viewTransitionClass = title.dataset.transitionClass;
    };
    addEventListener("pageswap", (e) => e.viewTransition && name(e.activation?.entry.url));
    addEventListener("pagereveal", (e) => e.viewTransition && name(window.navigation?.activation?.from?.url));
  }
</script>

<script>
  // Arrow buttons scroll the strip by one card; they disable themselves at either end.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>("li");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>

<style>
  /* Theme hooks: a page can give this section its own background, text and accent colour. */
  .pc {
    --pc-surface: var(--t-products-bg, var(--t-page, var(--study-blue)));

    color: var(--t-products-fg, inherit);
    background: var(--t-products-bg, transparent);
    --pc-pad: var(--layout-edge);

    padding-block: var(--space-4) var(--space-section);
  }

  /* Controls sit under the strip, so nothing but the photos peeks into the hero. */
  .pc__foot {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding-inline: var(--pc-pad);
  }

  .pc__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pc__controls button {
    display: grid;
    place-items: center;
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    color: inherit;
    background: transparent;
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius);
    font: inherit;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast), opacity var(--transition-fast);
  }

  .pc__controls button:hover:not(:disabled) {
    color: var(--pc-surface);
    background: var(--study-paper-bright);
  }

  .pc__controls button:disabled {
    opacity: var(--opacity-disabled);
    cursor: default;
  }

  .pc__controls a {
    margin-left: var(--space-4);
    color: inherit;
  }

  /* The strip: one row that scrolls sideways and snaps to each card; the next card peeks in at the edge. */
  .pc__track {
    display: flex;
    gap: var(--space-6);
    /* A sideways scroller clips vertically too, so leave headroom for the hover frame's flowers
       and pull the row back up by the same amount. */
    margin: calc(0px - var(--space-16)) 0 0;
    padding: var(--space-16) var(--pc-pad) var(--space-2);
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pc-pad);
    scrollbar-width: none;
  }

  .pc__track::-webkit-scrollbar {
    display: none;
  }

  .pc__card {
    --card-w: clamp(15rem, 23vw, 22rem);

    position: relative;
    flex: 0 0 var(--card-w);
    scroll-snap-align: start;
    transition: opacity var(--transition-normal);
  }

  .pc__card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Frame layers, back to front: photo (clipped), big hover name (free to overflow), ring. */
  .pc__frame {
    position: relative;
    display: block;
  }

  .pc__stage {
    position: relative;
    display: block;
    aspect-ratio: var(--ratio-product);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--pc-surface);
    transition: box-shadow var(--transition-normal);
  }

  /*
   * Hand-drawn floral frame, shown on hover. In the source image the pencil rectangle spans
   * 10.9–87.9% across and 9–94.6% down, so the image is scaled and offset to lay that rectangle
   * on the card's edges, with the flowers spilling past the corners. Inverted to read on blue.
   */
  .pc__frame :global(img.pc__drawn-frame) {
    position: absolute;
    top: -10.5%;
    left: -14.2%;
    width: 130%;
    height: 116.8%;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
    opacity: 0;
    filter: invert(1) brightness(1.15);
    transition: opacity var(--transition-normal);
  }

  .pc__frame :global(img.pc__ring) {
    position: absolute;
    z-index: var(--z-raised);
    top: 50%;
    left: 50%;
    width: 68%;
    height: auto;
    translate: -50% -50%;
    filter: drop-shadow(var(--shadow-object));
    transition: scale var(--transition-slow), rotate var(--transition-slow);
  }

  .pc__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  /*
   * The name is the only name: at rest it sits under the card; on hover it grows 4× into the photo,
   * lands behind the ring (the ring is lifted above it) and runs off the card's right edge.
   * The move is measured from the card width: the photo is 1.25× as tall as the card is wide.
   * It ignores the pointer, so the enlarged name never holds or steals the hover from a neighbour.
   */
  .pc__title {
    position: relative;
    z-index: var(--z-base);
    font-family: var(--t-display, var(--font-display));
    font-size: var(--font-size-xl);
    /* Heavy italic, like the name's heading on the product page. */
    font-weight: var(--font-weight-bold);
    font-style: italic;
    line-height: var(--font-leading-tight);
    white-space: nowrap;
    pointer-events: none;
    transform-origin: left top;
    transition: transform var(--transition-slow), color var(--transition-normal);
  }

  /* The final carousel name grows inward so its hover state cannot extend the scroll range. */
  .pc:not(.pc--grid) .pc__card:last-child .pc__title {
    transform-origin: right top;
  }

  /* The price travels the same way: from under the card into the photo's bottom-right corner, 2.5× larger. */
  .pc__price {
    position: relative;
    z-index: var(--z-base);
    font-family: var(--t-body, var(--font-display));
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    pointer-events: none;
    transform-origin: right bottom;
    transition: transform var(--transition-slow), color var(--transition-normal);
  }

  /*
   * Hover (and keyboard focus): the big pink name slides in behind the ring, the photo sharpens,
   * a thin pink frame appears, and the other cards step back.
   */
  @media (hover: hover) {
    .pc__card:hover,
    .pc__card:focus-within {
      z-index: var(--z-raised);
    }

    .pc__card a:is(:hover, :focus-visible) .pc__title {
      color: var(--t-accent, var(--study-pink));
      transform:
        translate(calc(var(--card-w) * 0.2), calc(var(--card-w) * -1.25 * 0.88 - var(--space-4)))
        scale(4);
    }

    .pc:not(.pc--grid) .pc__card:last-child a:is(:hover, :focus-visible) .pc__title {
      transform:
        translate(calc(var(--card-w) * -0.2), calc(var(--card-w) * -1.25 * 0.88 - var(--space-4)))
        scale(4);
    }

    .pc__card a:is(:hover, :focus-visible) .pc__price {
      color: var(--t-accent, var(--study-pink));
      transform:
        translate(calc(0px - var(--space-6)), calc(0px - var(--space-6) - var(--space-4) - 1lh))
        scale(2.5);
    }

    .pc__card a:is(:hover, :focus-visible) :global(img.pc__drawn-frame) {
      opacity: 1;
    }

    .pc__card a:is(:hover, :focus-visible) :global(img.pc__ring) {
      scale: 1.04;
      rotate: -2deg;
    }

    .pc__track:has(.pc__card:hover) .pc__card:not(:hover) {
      opacity: var(--opacity-subdued);
    }
  }

  /*
   * Grid: every card at once, in rows of four (three on tablets, two on phones). Card widths come
   * from the row's width (cqi), so the hover move still lands the name inside the photo.
   */
  .pc--grid {
    --pc-pad: 0px;

    container-type: inline-size;
    padding-block: 0;
  }

  .pc--grid .pc__track {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--card-w));
    justify-content: space-between;
    gap: var(--space-16) var(--space-6);
    margin: 0;
    padding: 0;
    overflow: visible;
  }

  .pc--grid :is(.pc__track, .pc__card) {
    --card-w: calc((100cqi - 3 * var(--space-6)) / 4);
  }

  @media (max-width: 1100px) {
    .pc--grid :is(.pc__track, .pc__card) {
      --card-w: calc((100cqi - 2 * var(--space-6)) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc__title,
    .pc__price {
      transition: color var(--transition-normal);
    }
  }

  @media (max-width: 700px) {
    .pc__foot {
      flex-wrap: wrap;
    }

    .pc__card {
      --card-w: 72vw;
    }

    .pc--grid .pc__track {
      row-gap: var(--space-8);
    }

    .pc--grid :is(.pc__track, .pc__card) {
      --card-w: calc((100cqi - var(--space-6)) / 2);
    }

    .pc--grid .pc__title {
      font-size: var(--font-size-lg);
    }
  }
</style>
