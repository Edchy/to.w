---
// Direction 5 · Arkiv: a museum catalogue. The hero is one small object on white (the bark
// ring's cutout) with one small line under it; colour appears only in the band of new pieces. Every
// study on this look now uses a shared hero (Hero.astro), the turning ring unless it says otherwise.
import type { Piece } from "./catalog";
import Hero, { type HeroKind } from "./Hero.astro";
import NewPieces from "./NewPieces.astro";
import Selection from "./Selection.astro";
import CourseTeaser from "./CourseTeaser.astro";
import Insta from "./Insta.astro";

type Props = { v: string; pieces: Piece[]; hero?: HeroKind };
const { v, pieces, hero } = Astro.props;
---

<Hero v={v} kind={hero ?? "ring"} />

<NewPieces v={v} pieces={pieces} />
<Selection v={v} pieces={pieces} mode="grid" />
<CourseTeaser v={v} />
<Insta />
