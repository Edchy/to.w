---
// One piece as a card: photo, name and price, and a "Nyhet" badge on the photo when asked (the
// smycken page marks new pieces). The piece's second photo rides along, hidden, and cross-fades in
// on hover (v5.css).
import { Image } from "astro:assets";
import { type Piece, liveHref } from "./catalog";

type Props = { piece: Piece; sizes?: string; eager?: boolean; photo?: number; badge?: boolean };
const { piece, sizes = "(max-width: 700px) 50vw, 25vw", eager = false, photo = 0, badge = false } = Astro.props;
---

<a class="v-card" href={liveHref(`smycken/${piece.slug}`)}>
  <span class="v-card__photo">
    <Image
      src={piece.images[photo] ?? piece.images[0]}
      alt={`${piece.title}, ${piece.kind} i återvunnet silver`}
      widths={[480, 960, 1440]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
    />
    {piece.images[1] && photo === 0 && (
      <Image class="v-card__alt" src={piece.images[1]} alt="" widths={[480, 960]} sizes={sizes} loading="lazy" />
    )}
    {badge && <span class="v-card__badge">Nyhet</span>}
  </span>
  <span class="v-card__title">{piece.title}</span>
  <span class="v-card__price">{piece.price}</span>
</a>
