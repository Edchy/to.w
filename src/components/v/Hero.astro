---
// The homepage hero, in two layouts:
//   ring-caption a smaller ring, the line set under it like a caption (the homepage)
//   ring-split   the line as a serif headline at the left, the ring in a pale panel at the right
//                — with two links under the headline: to the pieces, and to the courses (/v2/)
import TurningRing from "./TurningRing.astro";
import { liveHref } from "./catalog";

export type HeroKind = "ring-caption" | "ring-split";
type Props = { kind: HeroKind };
const { kind } = Astro.props;
const split = kind === "ring-split";
---

<section class:list={["hh", `hh--${kind}`]}>
  <div class="hh__media"><TurningRing /></div>
  <div class="hh__text">
    {split ? (
      <h1 class="hh__title"><span class="hh__line">Handgjorda smycken</span> <span class="hh__line">i <em>återvunnet silver</em></span></h1>
    ) : (
      <h1 class="hh__title">Handgjorda smycken i <em>återvunnet silver</em></h1>
    )}
    {split && (
      <p class="hh__actions">
        <a class="v-btn" href={liveHref("smycken")}>Se smyckena →</a>
        <a class="v-btn v-btn--secondary" href={liveHref("kurser")}>Kurser</a>
      </p>
    )}
  </div>
</section>

<style>
  .hh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    max-width: var(--layout-site-width);
    margin-inline: auto;
    padding: var(--space-16) var(--layout-gutter);
  }

  .hh__title em {
    font-style: inherit;
    color: var(--v-accent);
  }

  .hh__text {
    display: grid;
    justify-items: start;
    gap: var(--space-8);
  }

  /* ring-split: the headline at the left, the ring in a pale square panel at the right. */
  .hh--ring-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8) var(--grid-gutter);
  }

  /* The ring is larger than its pale square, so it reaches out past the box on every side. */
  .hh--ring-split {
    overflow: clip visible;
  }

  .hh--ring-split .hh__media {
    grid-column: 2;
    grid-row: 1;
    aspect-ratio: var(--v-ratio-square);
    background: var(--v-tint);
  }

  .hh--ring-split .hh__media :global(.v-ring3d) {
    width: 124%;
    margin: -12%;
  }

  .hh--ring-split .hh__text {
    grid-column: 1;
    grid-row: 1;
  }

  /* ring-split: the serif headline at a heading size. */
  .hh--ring-split .hh__title {
    font-family: var(--v-display);
    font-size: var(--v-size-hero-split);
    font-weight: var(--font-weight-regular);
    line-height: var(--v-leading-solid);
    letter-spacing: var(--font-tracking-tight);
  }

  .hh--ring-split .hh__title em {
    color: inherit;
  }

  /* Two set lines: "Handgjorda smycken" / "i återvunnet silver". */
  .hh__line {
    display: block;
    white-space: nowrap;
  }

  .hh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* ring-caption: a smaller ring, the line under it like a caption. */
  .hh--ring-caption {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .hh--ring-caption .hh__media {
    width: min(70vw, 24rem);
  }

  .hh--ring-caption .hh__text {
    justify-items: center;
  }

  .hh--ring-caption .hh__title {
    font-family: var(--v-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--font-leading-tight);
  }

  @media (max-width: 700px) {
    .hh {
      padding-block: var(--space-12);
    }

    .hh--ring-split {
      grid-template-columns: minmax(0, 1fr);
    }

    .hh--ring-split :is(.hh__media, .hh__text) {
      grid-column: 1;
      grid-row: auto;
    }

    /* On a phone the panel is kept small, so the headline and buttons show on the first screen. */
    .hh--ring-split .hh__media {
      justify-self: center;
      width: 64%;
    }
  }
</style>
