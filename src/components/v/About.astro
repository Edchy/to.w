---
// The about page in every direction: the portrait and the ways to get in touch.
import { Image } from "astro:assets";
import portrait from "../../assets/img/om/portrait.avif";
import { CONTACT_EMAIL, CONTACT_EMAIL_HREF } from "../../config/site";
---

<div class="v-about v-wrap">
  <h1 class="v-visually-hidden">Om Tove Wätte</h1>
  <figure class="v-about__portrait">
    <Image
      src={portrait}
      alt="Tove Wätte håller händerna framför ansiktet och bär flera silverringar."
      widths={[640, 1100, 1600]}
      sizes="(max-width: 900px) 100vw, 55vw"
      loading="eager"
      fetchpriority="high"
    />
  </figure>
  <dl class="v-about__facts">
    <div><dt>Mejl</dt><dd><a href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a></dd></div>
    <div><dt>Instagram</dt><dd><a class="v-about__ig" href="https://instagram.com/tovewatte">@tovewatte</a></dd></div>
  </dl>
</div>
