---
// The frame around every variant-study page: header, footer, and the switcher that jumps to the
// same page in another direction. Each direction's look lives in src/styles/v/v<n>.css.
// The live site uses it too, with v = "live": the study named by LIVE (catalog.ts), its links at the
// site root, indexable, and no switcher.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wordmark from "../site/Wordmark.astro";
import Doodle from "./Doodle.astro";
import VSwitch from "./VSwitch.astro";
import { CONTACT_EMAIL, CONTACT_EMAIL_HREF } from "../../config/site";
import { getVariant, vHref } from "./catalog";

import "@fontsource-variable/familjen-grotesk";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/v/base.css";
import "../../styles/v/v1.css";
import "../../styles/v/v2.css";
import "../../styles/v/v4.css";
import "../../styles/v/v5.css";
import "../../styles/v/footers.css";

type Props = {
  v: string;
  title?: string;
  description?: string;
  page?: string;
  /** Link preview and structured data, passed on to BaseLayout (the live pages set them). */
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
  /** Keep a live page out of search results anyway (the form's thank-you page). */
  noindex?: boolean;
};
const { v, title, description, page = "", image, imageAlt, jsonLd, noindex = false } = Astro.props;
const live = v === "live";

const nav = [
  { path: "smycken", label: "Smycken" },
  { path: "kurser", label: "Kurser" },
  { path: "om", label: "Om" },
];
const current = page.split("/")[0];
const { n: id, look, hero, footer, palette, font, of } = getVariant(v);
---

<BaseLayout bare noindex={!live || noindex} title={title} description={description} image={image} imageAlt={imageAlt} jsonLd={jsonLd}>
  <div class="v" data-v={look} data-id={id} data-base={of ?? id} data-hero={hero} data-footer={footer} data-palette={palette} data-font={font}>
    <header class="v-head">
      <a class="v-head__mark" href={vHref(v)} aria-label="TO·W – till startsidan"><Wordmark aria-hidden="true" /></a>
      <nav aria-label="Huvudnavigering">
        <ul class="v-head__nav" role="list">
          {nav.map((link) => (
            <li><a href={vHref(v, link.path)} aria-current={current === link.path ? "page" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <button class="v-menu-btn" type="button" aria-expanded="false" aria-controls="v-menu" data-menu-toggle>
        <span data-menu-label>Meny</span>
      </button>
    </header>

    <div class="v-menu" id="v-menu" hidden>
      <nav aria-label="Meny">
        <ul class="v-menu__links" role="list">
          <li><a href={vHref(v)}>Hem</a></li>
          {nav.map((link) => (
            <li><a href={vHref(v, link.path)} aria-current={current === link.path ? "page" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <p class="v-menu__meta">
        <a href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a>
        <a href="https://instagram.com/tovewatte">@tovewatte</a>
      </p>
    </div>

    <div class="v-main">
      <slot />
    </div>

    <footer class="v-foot">
      <Doodle name="cheetah" />
      <Doodle name="bird" place="foot" />
      <a class="v-foot__mail" href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a>
      <ul class="v-foot__links" role="list">
        {nav.map((link) => <li><a href={vHref(v, link.path)}>{link.label}</a></li>)}
        <li class="v-foot__ig"><a href="https://instagram.com/tovewatte">Instagram</a></li>
      </ul>
      <a class="v-foot__top" href="#">Till toppen ↑</a>
      <p class="v-foot__small">Tove Wätte · © {new Date().getFullYear()} · site by: <a href="https://thinksmall.studio">thinksmall studio</a></p>
    </footer>
  </div>

  {!live && <VSwitch current={v} page={page} />}
</BaseLayout>

<script>
  // The menu on phones and tablets: the button opens and closes it; Esc or choosing a link closes
  // it too. While it is open the page behind does not scroll.
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("v-menu");
  const label = toggle?.querySelector("[data-menu-label]");
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Stäng" : "Meny";
    document.documentElement.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
