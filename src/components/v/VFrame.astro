---
// The frame around every page: header, the menu on phones and tablets, and the footer.
// The look lives in src/styles/v/ (base.css, v5.css, footers.css); its selectors key on the data
// attributes set on .v below, kept from the design studies the site grew out of.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wordmark from "../site/Wordmark.astro";
import bird from "../../assets/img/illustrations/bird.webp";
import { CONTACT_EMAIL, CONTACT_EMAIL_HREF } from "../../config/site";
import { liveHref } from "./catalog";

import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/v/base.css";
import "../../styles/v/v5.css";
import "../../styles/v/footers.css";

type Props = {
  title?: string;
  description?: string;
  page?: string;
  /** Link preview and structured data, passed on to BaseLayout. */
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
  /** Keep a page out of search results (the form's thank-you page, /v2/). */
  noindex?: boolean;
};
const { title, description, page = "", image, imageAlt, jsonLd, noindex = false } = Astro.props;

const nav = [
  { path: "smycken", label: "Smycken" },
  { path: "kurser", label: "Kurser" },
  { path: "om", label: "Om" },
];
const current = page.split("/")[0];
---

<BaseLayout noindex={noindex} title={title} description={description} image={image} imageAlt={imageAlt} jsonLd={jsonLd}>
  <div class="v" data-v="5" data-base="13" data-font="serif" data-footer="center">
    <header class="v-head">
      <a class="v-head__mark" href={liveHref()} aria-label="TO·W – till startsidan"><Wordmark aria-hidden="true" /></a>
      <nav aria-label="Huvudnavigering">
        <ul class="v-head__nav" role="list">
          {nav.map((link) => (
            <li><a href={liveHref(link.path)} aria-current={current === link.path ? "page" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <button class="v-menu-btn" type="button" aria-expanded="false" aria-controls="v-menu" data-menu-toggle>
        <span data-menu-label>Meny</span>
      </button>
    </header>

    <div class="v-menu" id="v-menu" hidden>
      <nav aria-label="Meny">
        <ul class="v-menu__links" role="list">
          <li><a href={liveHref()}>Hem</a></li>
          {nav.map((link) => (
            <li><a href={liveHref(link.path)} aria-current={current === link.path ? "page" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <p class="v-menu__meta">
        <a href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a>
        <a href="https://instagram.com/tovewatte">@tovewatte</a>
      </p>
    </div>

    <div class="v-main">
      <slot />
    </div>

    <footer class="v-foot">
      <Image class="v-foot__bird" src={bird} alt="" aria-hidden="true" widths={[200, 400]} sizes="8rem" loading="lazy" />
      <a class="v-foot__mail" href={CONTACT_EMAIL_HREF}>{CONTACT_EMAIL}</a>
      <ul class="v-foot__links" role="list">
        {nav.map((link) => <li><a href={liveHref(link.path)}>{link.label}</a></li>)}
        <li class="v-foot__ig"><a href="https://instagram.com/tovewatte">Instagram</a></li>
      </ul>
      <p class="v-foot__small">Tove Wätte · © {new Date().getFullYear()} · site by: <a href="https://thinksmall.studio">thinksmall studio</a></p>
    </footer>
  </div>
</BaseLayout>

<script>
  // The menu on phones and tablets: the button opens and closes it; Esc or choosing a link closes
  // it too. While it is open the page behind does not scroll.
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("v-menu");
  const label = toggle?.querySelector("[data-menu-label]");
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Stäng" : "Meny";
    document.documentElement.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  // Page swaps: a piece's card photo grows into the large photo on its page (global.css styles the
  // move). The card is named only as the page leaves, so a page showing the same piece twice never
  // carries the name twice; a leaving piece page drops its own photo's name the same way.
  type SwapEvent = Event & { viewTransition: ViewTransition | null; activation: { entry: { url: string } } | null };
  let clicked: HTMLAnchorElement | null = null;
  let named: HTMLElement | null = null;
  document.addEventListener("click", (event) => {
    clicked = (event.target as Element).closest<HTMLAnchorElement>("a.v-card");
  });
  window.addEventListener("pageswap", (event) => {
    const { viewTransition, activation } = event as SwapEvent;
    document.querySelector<HTMLElement>(".v-pd__lead")?.style.setProperty("view-transition-name", "none");
    named?.style.removeProperty("view-transition-name");
    named = null;
    if (!viewTransition || !clicked || clicked.href !== activation?.entry.url) return;
    named = clicked.querySelector<HTMLElement>(".v-card__photo");
    named?.style.setProperty("view-transition-name", "piece-photo");
  });
</script>
