---
// The switcher between the design studies: a small fixed pill at the bottom of every /v/ page,
// the original site (0) included. It jumps to the same page in another version, or to the live site.
import "@fontsource/dm-mono/400.css";
import { VARIANTS, liveHref, vHref } from "./catalog";

type Props = { current: string; page?: string };
const { current, page = "" } = Astro.props;
const versions = [{ n: "0", name: "Original" }, ...VARIANTS];
const name = versions.find((version) => version.n === current)?.name ?? "";
---

<nav class="v-switch" aria-label="Designvarianter">
  <span class="v-switch__label">{name}</span>
  {versions.map((version) => (
    <a href={vHref(version.n, page)} aria-current={version.n === current ? "true" : undefined} title={version.name}>{version.n}</a>
  ))}
  <a class="v-switch__live" href={liveHref(page)}>live</a>
</nav>

<style>
  /* A small fixed pill, the same in every version. */
  .v-switch {
    position: fixed;
    max-width: calc(100% - 2 * var(--space-4));
    overflow-x: auto;
    scrollbar-width: none;
    z-index: var(--z-modal);
    bottom: var(--space-4);
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
    background: var(--pure-black);
    color: var(--pure-white);
    font-family: var(--v-font-dm-mono);
    font-size: var(--font-size-xs);
    letter-spacing: var(--v-tracking-label);
    text-transform: uppercase;
    box-shadow: var(--shadow-object-soft);
  }

  .v-switch__label {
    padding-inline: var(--space-2);
    min-width: 7ch;
  }

  .v-switch a {
    flex: none;
    display: grid;
    place-items: center;
    min-width: var(--size-control);
    min-height: var(--size-control);
    color: inherit;
    text-decoration: none;
  }

  .v-switch a:hover {
    background: color-mix(in oklch, var(--pure-white) 18%, transparent);
  }

  .v-switch a[aria-current="true"] {
    background: var(--pure-white);
    color: var(--pure-black);
  }

  .v-switch .v-switch__live {
    padding-inline: var(--space-4);
  }

  @media (max-width: 700px) {
    .v-switch__label {
      display: none;
    }
  }
</style>
