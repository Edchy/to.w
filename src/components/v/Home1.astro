---
// Direction 1 · Spec: a grey spec-sheet band (headline + one sheet per new piece), then a grid of pieces, the course and Instagram.
import { Image } from "astro:assets";
import { type Piece, vHref } from "./catalog";
import Hero, { type HeroKind } from "./Hero.astro";
import NewPieces from "./NewPieces.astro";
import Selection from "./Selection.astro";
import CourseTeaser from "./CourseTeaser.astro";
import Insta from "./Insta.astro";

type Props = { v: string; pieces: Piece[]; hero?: HeroKind };
const { v, pieces, hero } = Astro.props;
const fresh = pieces.filter((piece) => piece.nytt);
---

{hero ? (
  <>
    <Hero v={v} kind={hero} />
    <NewPieces v={v} pieces={pieces} />
  </>
) : (
<section class="s1-band" id="nytt" aria-label="Nyheter">
  <div class="s1-band__inner">
    <div class="s1-hero">
      <span class="s1-cross" aria-hidden="true"></span>
      <h1 class="s1-hero__title">Handgjorda silversmycken</h1>
    </div>

    {fresh.map((piece, i) => (
      <a class="s1-sheet" id={`nytt-${i + 1}`} href={vHref(v, `smycken/${piece.slug}`)}>
        <span class="s1-sheet__name">{piece.title}</span>
        <span class="s1-sheet__photo">
          <Image src={piece.images[0]} alt={`${piece.title}, ${piece.kind} i återvunnet silver`} widths={[400, 800]} sizes="(max-width: 700px) 45vw, 20rem" loading="eager" />
        </span>
        <span class="s1-sheet__price">{piece.price}</span>
      </a>
    ))}
  </div>
</section>
)}

<Selection v={v} pieces={pieces} mode="grid" />
<CourseTeaser v={v} />
<Insta />
