---
// A selection of pieces on the homepage (not all of them: that is the smycken page), shown as a
// four-up grid, then a link to every piece.
import { type Piece, liveHref } from "./catalog";
import PieceCard from "./PieceCard.astro";

type Props = { pieces: Piece[] };
const { pieces } = Astro.props;
const picks = pieces.filter((piece) => !piece.nytt).slice(0, 4);
---

<section class="v-sel" aria-labelledby="v-sel-title">
  <div class="v-wrap">
    <div class="v-sel__head">
      <h2 class="v-sel__title" id="v-sel-title">Smycken</h2>
    </div>
    <ul class="v-sel__track">
      {picks.map((piece) => <li><PieceCard piece={piece} sizes="(max-width: 700px) 45vw, 18rem" /></li>)}
    </ul>
    <a class="v-sel__all" href={liveHref("smycken")}>Alla smycken →</a>
  </div>
</section>
