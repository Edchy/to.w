---
// The silver band turning slowly and tilting gently on two slow rhythms, so it never moves in just
// one plane. A band with a real ring's section (public/models/band-ring-mono.glb, built by
// scripts/make-band-ring.mjs), lit by a soft studio made of the page's colours (the warm paper, and
// the blue where silver shows dark: public/env/page-warm-blue.hdr, scripts/make-page-env.mjs), so it
// almost melts into the page. Inside it carries hallmarks and a line of Karin Boye's "I rörelse" in
// IBM Plex Mono Light Italic; it starts with the hallmarks facing you and turns slowly, once a
// minute, so the line passes by. A soft satin sheen. It can be dragged; with reduced motion it
// stands still. Size it from outside: it fills its width as a square. Extra attributes land on the
// element.
type Props = { [key: string]: unknown };
const rest = Astro.props;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
// The band's hallmarks sit inside at 108° round the ring (scripts/make-band-ring.mjs puts them at
// 0.3 of the way round); seen from 162° the camera looks across the ring straight at them.
---

{/* Start fetching the model, its light and the decoder at once, instead of after the 3D library has
    started up (attributes match model-viewer's own requests, so the browser reuses them). */}
<link rel="preload" href={`${baseUrl}models/band-ring-mono.glb`} as="fetch" crossorigin="anonymous" />
<link rel="preload" href={`${baseUrl}env/page-warm-blue.hdr`} as="fetch" crossorigin="anonymous" />
<link rel="preload" href={`${baseUrl}vendor/meshopt_decoder.js`} as="script" />

<model-viewer
  class="v-ring3d"
  src={`${baseUrl}models/band-ring-mono.glb`}
  alt="En tunn rund silverring i 3D. Dra för att vrida."
  camera-controls
  disable-zoom
  touch-action="pan-y"
  interaction-prompt="none"
  camera-orbit="162deg 62deg 100%"
  min-camera-orbit="auto 0deg 100%"
  max-camera-orbit="auto 180deg 100%"
  environment-image={`${baseUrl}env/page-warm-blue.hdr`}
  tone-mapping="neutral"
  exposure="1.05"
  shadow-intensity="0"
  {...rest}
></model-viewer>

<style>
  /* model-viewer gives itself a fixed 150px height and a loading bar; both are overridden here. */
  .v-ring3d {
    --poster-color: transparent;
    --progress-bar-color: transparent;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--v-ratio-square);
    cursor: grab;
    /* Hidden until loaded, finished and drawn; then it fades in and settles to full size. */
    opacity: 0;
    scale: 0.96;
    transition:
      opacity var(--duration-reveal) var(--ease-out-quart),
      scale var(--duration-reveal) var(--ease-out-expo);
  }

  .v-ring3d.is-ready {
    opacity: 1;
    scale: 1;
  }

  .v-ring3d:active {
    cursor: grabbing;
  }

  @media (prefers-reduced-motion: reduce) {
    .v-ring3d {
      scale: 1;
    }
  }
</style>

<script>
  import { ModelViewerElement } from "@google/model-viewer";

  // band-ring-mono.glb is meshopt-compressed; the decoder (meshoptimizer 0.24.0) is served from the
  // site itself rather than a CDN. Set before any ring starts loading.
  ModelViewerElement.meshoptDecoderLocation = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/vendor/meshopt_decoder.js`;

  // The tilt: forward and back, and side to side, each on its own slow period (in seconds), kept
  // small (TILT) so the satin ring moves calmly.
  const PITCH = { deg: 28, period: 11 };
  const ROLL = { deg: 16, period: 7 };
  const TILT = 0.35;

  // The surface: the silver's colour and how rough (matte) the metal is, on top of the model's own
  // roughness map (dents duller). Colours are linear RGB.
  const SURFACE = { color: [0.96, 0.96, 0.97, 1] as [number, number, number, number], roughness: 0.6 };

  // The band turns slowly (degrees per second) from its hallmarks, so the poem passes by; negative
  // so the lettering moves leftwards and reads like a line of text coming in from the right.
  const TURN = -6;

  type Material = {
    pbrMetallicRoughness: {
      baseColorTexture: { setTexture: (texture: null) => void } | null;
      setBaseColorFactor: (color: [number, number, number, number]) => void;
      setRoughnessFactor: (roughness: number) => void;
    };
  };
  type RingElement = HTMLElement & { model?: { materials: Material[] } };

  // model-viewer bug (4.3.1 and 4.4.0): changing `orientation` calls the AR renderer's onUpdateScene
  // even when no AR session is running; it throws before asking for a redraw, so the ring never
  // visibly moves. Make that call do nothing outside AR. The renderer sits behind an internal
  // symbol; if a later version renames it, this quietly does nothing.
  type ArRenderer = { isPresenting: boolean; onUpdateScene: () => void; guarded?: boolean };
  const guardAr = (model: HTMLElement) => {
    for (let proto = Object.getPrototypeOf(model); proto; proto = Object.getPrototypeOf(proto)) {
      const key = Object.getOwnPropertySymbols(proto).find((symbol) => symbol.description === "renderer");
      if (!key) continue;
      const ar = (model as unknown as Record<symbol, { arRenderer?: ArRenderer }>)[key]?.arRenderer;
      if (!ar || ar.guarded) return;
      const update = ar.onUpdateScene;
      ar.onUpdateScene = () => {
        if (ar.isPresenting) update();
      };
      ar.guarded = true;
      return;
    }
  };

  const rings = document.querySelectorAll<RingElement>(".v-ring3d");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ready = new Map<HTMLElement, number>(); // ring → when it loaded

  for (const model of rings) {
    model.addEventListener(
      "load",
      () => {
        for (const material of model.model?.materials ?? []) {
          material.pbrMetallicRoughness.baseColorTexture?.setTexture(null);
          material.pbrMetallicRoughness.setBaseColorFactor(SURFACE.color);
          material.pbrMetallicRoughness.setRoughnessFactor(SURFACE.roughness);
        }
        // Reveal two frames later, so the finished ring has been drawn before it fades in.
        requestAnimationFrame(() => requestAnimationFrame(() => model.classList.add("is-ready")));
        // Start tilting only now; changing it before it has loaded makes model-viewer throw.
        guardAr(model);
        ready.set(model, performance.now());
      },
      { once: true },
    );
  }

  if (!reduced && rings.length) {
    const wave = ({ deg, period }: { deg: number; period: number }, t: number) =>
      deg * Math.sin((2 * Math.PI * t) / period);
    const tilt = (now: number) => {
      const t = now / 1000;
      for (const [model, loaded] of ready) {
        const yaw = (TURN * (now - loaded)) / 1000;
        model.setAttribute("orientation", `${TILT * wave(ROLL, t)}deg ${TILT * wave(PITCH, t)}deg ${yaw}deg`);
      }
      requestAnimationFrame(tilt);
    };
    requestAnimationFrame(tilt);
  }
</script>
