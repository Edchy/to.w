---
type Props = {
  href: string;
  size?: "nav" | "footer";
};

const { href, size = "nav" } = Astro.props;
---

<a href={href} class:list={["wordmark", `wordmark--${size}`]} aria-label="Tove Wätte — hem">
  <span class="wordmark__name">tove wätte</span>
</a>

<style>
  .wordmark {
    display: inline-block;
    width: fit-content;
    color: var(--color-wordmark-nav);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  @media (hover: hover) {
    .wordmark:hover {
      opacity: 0.7;
    }
  }

  .wordmark__name {
    display: block;
    font-family: var(--font-body-text);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--font-tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wordmark--nav .wordmark__name,
  .wordmark--footer .wordmark__name {
    font-size: var(--font-size-base);
  }

  @media (max-width: 700px) {
    .wordmark--nav .wordmark__name,
    .wordmark--footer .wordmark__name {
      font-size: var(--font-size-sm);
    }
  }
</style>
