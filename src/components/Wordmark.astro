---
type Props = {
  href: string;
  size?: "nav" | "footer";
};

const { href, size = "nav" } = Astro.props;
---

<a href={href} class:list={["wordmark", `wordmark--${size}`]} aria-label="to.w — hem">
  <span class="wordmark__name">to.w</span>
</a>

<style>
  .wordmark {
    display: inline-block;
    width: fit-content;
    color: var(--color-wordmark-nav);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  @media (hover: hover) {
    .wordmark:hover {
      opacity: 0.7;
    }
  }

  .wordmark__name {
    font-family: var(--font-brand-text);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--font-tracking-negative);
    line-height: 1;
  }

  .wordmark--nav .wordmark__name {
    font-size: var(--font-size-xl);
  }

  .wordmark--footer .wordmark__name {
    font-size: var(--font-size-lg);
  }
</style>
