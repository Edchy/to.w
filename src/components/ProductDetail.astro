---
import { Image } from "astro:assets";
import { CONTACT_EMAIL_HREF } from "../config/site";

type Props = {
  title: string;
  price: number;
  sizes: string[];
  description?: string;
  material?: string;
  technique?: string;
  design?: string;
  images: ImageMetadata[];
  imagesHd?: ImageMetadata[];
  transitionName?: string;
};

const { title, price, sizes, description, material, technique, design, images, imagesHd, transitionName } = Astro.props;
const image = (imagesHd ?? images)[0];

const fmt = new Intl.NumberFormat("sv-SE").format;
const formattedPrice = fmt(price);
const hasSizes = sizes.length > 0;
const sizeLabel = sizes.length === 1 ? "storlek" : "storlekar";
const orderSizeLine =
  sizes.length === 1
    ? `Storlek / variant: ${sizes[0]}`
    : `Storlek / variant${hasSizes ? ` (välj: ${sizes.join(", ")})` : ""}:`;
const orderSubject = encodeURIComponent(`Beställning: ${title}`);
const orderBody = encodeURIComponent(`Hej Tove,

Jag vill gärna beställa ${title} (${formattedPrice} kr).

${orderSizeLine}
Antal:
LEVERANS: [post / hämtas i ateljén / överlämning i Järna]
Adress, om post:
Telefon:
Övrigt:

Vänliga hälsningar,`);
const orderHref = `${CONTACT_EMAIL_HREF}?subject=${orderSubject}&body=${orderBody}`;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<article class="pd">
  <figure class="pd__visual" transition:name={transitionName}>
    <Image
      src={image}
      alt={title}
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <div class="pd__info">
    <a class="pd__back" href={withBase("/smycken")}>alla smycken</a>

    <header class="pd__summary">
      <h1
        class="pd__title"
        transition:name={transitionName ? `${transitionName.replace("product-", "product-title-")}` : undefined}
        transition:animate="none"
      >
        {title}
      </h1>
      <p class="pd__price">{formattedPrice} kr</p>
    </header>

    {description && <p class="pd__description">{description}</p>}

    {(material || technique || design || hasSizes) && (
      <dl class="pd__facts">
        {material && (
          <div><dt>material</dt><dd>{material}</dd></div>
        )}
        {technique && (
          <div><dt>teknik</dt><dd>{technique}</dd></div>
        )}
        {design && (
          <div><dt>form</dt><dd>{design}</dd></div>
        )}
        {hasSizes && (
          <div><dt>{sizeLabel}</dt><dd>{sizes.join(", ")}</dd></div>
        )}
      </dl>
    )}

    <div class="pd__order">
      <a class="pd__buy" href={orderHref}>Beställ via mejl</a>
      <p>
        Varje smycke tillverkas individuellt efter beställning. Jag återkommer med bekräftelse,
        betalningsinfo och ungefärlig leveranstid. Har du frågor eller särskilda önskemål kan du
        <a href={CONTACT_EMAIL_HREF}> kontakta mig</a>.
      </p>
    </div>
  </div>
</article>

<style>
  .pd {
    width: 100%;
    max-width: var(--layout-site-width);
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.65fr);
    align-items: stretch;
  }

  .pd__visual {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-card);
  }

  .pd__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), filter var(--transition-slow);
  }

  .pd__info {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--space-10);
    color: var(--color-text-inverse);
    background: var(--color-bg-inverse);
  }

  .pd__back {
    align-self: flex-start;
    min-height: var(--space-10);
    font-size: var(--font-size-sm);
    color: var(--color-text-inverse-muted);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .pd__summary {
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-16);
  }

  .pd__title {
    max-width: 12ch;
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-inverse);
  }

  .pd__price {
    font-size: var(--font-size-lg);
    color: var(--color-text-inverse-muted);
    font-variant-numeric: tabular-nums;
  }

  .pd__description {
    max-width: 46ch;
    margin-top: var(--space-8);
    line-height: var(--font-leading-relaxed);
    color: var(--color-text-inverse);
  }

  .pd__facts {
    display: grid;
    gap: 0;
    margin: var(--space-8) 0 0;
  }

  .pd__facts > div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.45fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border-inverse);
  }

  .pd__facts > div:last-child {
    border-bottom: 1px solid var(--color-border-inverse);
  }

  .pd__facts dt,
  .pd__facts dd {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--font-leading-snug);
  }

  .pd__facts dt {
    color: var(--color-text-inverse-muted);
  }

  .pd__facts dd {
    color: var(--color-text-inverse);
  }

  .pd__order {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .pd__buy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--space-12);
    padding: var(--space-3) var(--space-6);
    color: var(--color-text-primary);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-bg-surface);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-normal), color var(--transition-normal);
  }

  .pd__order p {
    max-width: 48ch;
    font-size: var(--font-size-xs);
    line-height: var(--font-leading-relaxed);
    color: var(--color-text-inverse-muted);
  }

  .pd__order p a {
    color: var(--color-text-inverse);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .pd__info :focus-visible {
    outline-color: var(--color-text-inverse);
  }

  @media (hover: hover) {
    .pd__visual:hover :global(img) {
      filter: contrast(1.03);
      transform: scale(1.02);
    }

    .pd__buy:hover {
      color: var(--color-text-inverse);
      background: transparent;
    }
  }

  @media (max-width: 1000px) {
    .pd {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }

    .pd__visual {
      aspect-ratio: 16 / 10;
    }

    .pd__info {
      padding: var(--space-8) var(--layout-gutter) var(--space-12);
    }

    .pd__summary {
      margin-top: 0;
      padding-top: var(--space-10);
    }
  }

  @media (max-width: 600px) {
    .pd__visual {
      aspect-ratio: 4 / 3;
    }

    .pd__info {
      padding-top: var(--space-6);
    }

    .pd__facts > div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
